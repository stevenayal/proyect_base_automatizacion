<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Grupo 05 - Tarjetas Credito/Debito">
      <stringProp name="TestPlan.comments">Plan de carga del grupo 05 sobre https://aiquaa-sandbox-api.vercel.app. Cubre el endpoint de consulta (GET api/v1/tarjetas/{id}) y el de creacion (POST api/v1/tarjetas), y encadena ambos: el id que devuelve la emision alimenta una consulta, de modo que la prueba no depende de ids fijos del seed.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables definidas por el Usuario">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Valores por defecto - AIQUAA Sandbox API">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Variables definidas por el Usuario">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${__P(host,aiquaa-sandbox-api.vercel.app)}</stringProp>
        <stringProp name="HTTPSampler.port">${__P(port,443)}</stringProp>
        <stringProp name="HTTPSampler.protocol">${__P(protocol,https)}</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Cabeceras - api key y content type">
        <stringProp name="TestPlan.comments">La api key entra por la propiedad apiKey (-JapiKey=...), nunca va escrita en el plan. En CI la provee el secret GRUPO05_API_KEY.</stringProp>
        <collectionProp name="HeaderManager.headers">
          <elementProp name="x-api-key" elementType="Header">
            <stringProp name="Header.name">x-api-key</stringProp>
            <stringProp name="Header.value">${__P(apiKey,)}</stringProp>
          </elementProp>
          <elementProp name="Content-Type" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Grupo de Hilos">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,2)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampUp,0)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Controlador Bucle">
          <stringProp name="LoopController.loops">${__P(loops,10)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Ritmo bajo el rate limit del sandbox (30 req/min)">
          <stringProp name="TestPlan.comments">La API sandbox limita a 30 req/min por api-key y responde 429 al pasarse. Se pacea todo el grupo de hilos a 18 muestras/min para dejar margen: la key es compartida por toda la clase, asi que el margen cubre el trafico de otras corridas. Subir threads o loops sin subir este valor solo alarga la corrida.</stringProp>
          <intProp name="calcMode">2</intProp>
          <doubleProp>
            <name>throughput</name>
            <value>18.0</value>
            <savedValue>0.0</savedValue>
          </doubleProp>
        </ConstantThroughputTimer>
        <hashTree/>
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Consulta - Tarjeta por id (datos del CSV)"/>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV - Ids de tarjeta">
            <stringProp name="TestPlan.comments">Mezcla ids del seed (respuesta 200) con un id invalido (0 -&gt; 400) y uno inexistente (9999 -&gt; 404), para ejercitar tambien las rutas de error bajo carga. Cada fila trae el codigo que se espera, asi la asercion vale para las tres.</stringProp>
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">${__P(consultaCsvPath,grupos/grupo-05-tarjetas-credito-debito/tests/performance/data/grupo05_consulta_tarjetas.csv)}</stringProp>
            <boolProp name="ignoreFirstLine">true</boolProp>
            <boolProp name="quotedData">false</boolProp>
            <boolProp name="recycle">true</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">false</boolProp>
            <stringProp name="variableNames">tarjetaId,codigoEsperadoConsulta</stringProp>
          </CSVDataSet>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET - Obtener tarjeta por id">
            <stringProp name="TestPlan.comments">https://aiquaa-sandbox-api.vercel.app/api/v1/tarjetas/{id} - endpoint de consulta.</stringProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Variables definidas por el Usuario">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
            <stringProp name="HTTPSampler.path">api/v1/tarjetas/${tarjetaId}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Responde el codigo esperado por el CSV">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="codigoEsperadoConsulta">${codigoEsperadoConsulta}</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">La consulta del id ${tarjetaId} debia responder ${codigoEsperadoConsulta}</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">true</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Creacion - Emitir tarjeta y consultar la creada"/>
        <hashTree>
          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV - Datos de emision">
            <stringProp name="TestPlan.comments">Filas validas para la carga normal (201) y filas de borde (usuarioId 0 e inexistente, tipo y marca fuera del enum) que la API rechaza con 400. El codigo esperado viaja en el CSV.</stringProp>
            <stringProp name="delimiter">,</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">${__P(emisionCsvPath,grupos/grupo-05-tarjetas-credito-debito/tests/performance/data/grupo05_emision_tarjetas.csv)}</stringProp>
            <boolProp name="ignoreFirstLine">true</boolProp>
            <boolProp name="quotedData">false</boolProp>
            <boolProp name="recycle">true</boolProp>
            <stringProp name="shareMode">shareMode.all</stringProp>
            <boolProp name="stopThread">false</boolProp>
            <stringProp name="variableNames">usuarioId,tipo,marca,codigoEsperadoEmision</stringProp>
          </CSVDataSet>
          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST - Emitir tarjeta">
            <stringProp name="TestPlan.comments">https://aiquaa-sandbox-api.vercel.app/api/v1/tarjetas - endpoint de creacion. De aca sale el dato dinamico: el id de la tarjeta emitida.</stringProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
    &quot;usuarioId&quot;: ${usuarioId},&#xd;
    &quot;tipo&quot;: &quot;${tipo}&quot;,&#xd;
    &quot;marca&quot;: &quot;${marca}&quot;&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.path">api/v1/tarjetas</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extraer id de la tarjeta emitida">
              <stringProp name="TestPlan.comments">La respuesta 201 trae data.id. En las filas de borde no hay data.id y la variable queda en SIN_ID, que es lo que corta el IfController.</stringProp>
              <stringProp name="JSONPostProcessor.referenceNames">tarjetaCreadaId</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.id</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">SIN_ID</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Responde el codigo esperado por el CSV">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="codigoEsperadoEmision">${codigoEsperadoEmision}</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">La emision para usuarioId ${usuarioId} / ${tipo} / ${marca} debia responder ${codigoEsperadoEmision}</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">true</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Solo si la emision devolvio un id">
            <stringProp name="IfController.condition">${__groovy(vars.get('tarjetaCreadaId') != 'SIN_ID')}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET - Consultar la tarjeta recien emitida">
              <stringProp name="TestPlan.comments">Consulta por el id dinamico obtenido del POST, sin depender de ids fijos del seed (que otros grupos borran).</stringProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="Variables definidas por el Usuario">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
              <stringProp name="HTTPSampler.path">api/v1/tarjetas/${tarjetaCreadaId}</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="La tarjeta creada responde 200">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="200">200</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message">La tarjeta ${tarjetaCreadaId} recien emitida debia poder consultarse con 200</stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">8</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="El id consultado es el que devolvio la emision">
                <stringProp name="JSON_PATH">$.data.id</stringProp>
                <stringProp name="EXPECTED_VALUE">${tarjetaCreadaId}</stringProp>
                <boolProp name="JSONVALIDATION">true</boolProp>
                <boolProp name="EXPECT_NULL">false</boolProp>
                <boolProp name="INVERT">false</boolProp>
                <boolProp name="ISREGEX">true</boolProp>
              </JSONPathAssertion>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
