                  "\r\n//validar conexión \r\npm.test(\"Código de estado es 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// validar que todos los resultados sean verdaderos\r\npm.test(\"Todos los usuarios devueltos están activos\", function () {\r\n    var jsonData = pm.response.json();\r\n    \r\n    // Ajusta 'jsonData' si tu API devuelve los datos dentro de una propiedad (ej. jsonData.data o jsonData.rows)\r\n    var usuarios = Array.isArray(jsonData) ? jsonData : (jsonData.data || jsonData.rows);\r\n    \r\n    pm.expect(usuarios).to.be.an('array');\r\n    \r\n    usuarios.forEach(function(usuario, index) {\r\n        pm.expect(usuario.activo, `El usuario en el índice ${index} no está activo`).to.eql(true);\r\n    });\r\n});\r\n"
