                "exec": [
                  "//validar conexión  \r\npm.test(\"El código de estado es un error de validación (400 o 422)\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([400, 422]);\r\n});\r\n\r\n    // Verificar que el mensaje de error indique la falta de estos campos \r\n\r\npm.test(\"El mensaje de error indica que 'servicio' es obligatorio\", function () {\r\n    var jsonData = pm.response.json();\r\n    var respuestaStr = JSON.stringify(jsonData).toLowerCase();\r\n    pm.expect(respuestaStr).to.include('servicio');\r\n});\r\n\r\npm.test(\"El mensaje de error indica que 'fecha' es obligatoria\", function () {\r\n    var jsonData = pm.response.json();\r\n    var respuestaStr = JSON.stringify(jsonData).toLowerCase();\r\n    pm.expect(respuestaStr).to.include('fecha');\r\n});\r\n\r\n // control de fecha pasada\r\npm.test(\"La fecha y hora debe ser mayor o igual a ahora\", function () {\r\n    var jsonData = pm.response.json();\r\n    var fechaRespuestaStr = jsonData.fechaHora || (jsonData.data && jsonData.data.fechaHora);    \r\n    \r\n    pm.expect(fechaRespuestaStr, \"Fecha obligatorio\").to.be.a('string');    \r\n    \r\n    var fechaRespuesta = new Date(fechaRespuestaStr).getTime();\r\n        // o nos aseguramos de tomar el tiempo \r\n    var ahora = new Date().getTime() - 60000;     \r\n    console.log(\"Fecha respuesta:\", fechaRespuestaStr, \"(\", fechaRespuesta, \")\");\r\n    console.log(\"Fecha ahora (-margen):\", new Date(ahora).toISOString(), \"(\", ahora, \")\");    \r\n    pm.expect(fechaRespuesta).to.be.at.least(ahora, \"No se puede registrar una fecha y hora pasada\");\r\n});"
