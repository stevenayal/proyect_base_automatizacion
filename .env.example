# URL base del sitio bajo prueba
BASE_URL=https://aiquaa-sandbox-web.vercel.app/

# URL base de la API del sandbox
API_URL=https://aiquaa-sandbox-api.vercel.app

# API key del sandbox (cabecera x-api-key). Pedir la del equipo al docente.
SANDBOX_API_KEY=

# Curso del sandbox usado por LoginPage (1 automatizacion | 2 productos bancarios)
SANDBOX_CURSO=1

# Datos de prueba del sandbox usados por los escenarios web del grupo 05
SANDBOX_USUARIO_ID=1
SANDBOX_EMAIL_CLIENTE=bruno.ramirez@example.com

# Credenciales de prueba (no usar datos reales en el repo)
TEST_USER=usuario@ejemplo.com
TEST_PASSWORD=contrasena_de_prueba

# Identificador del grupo (ej: grupo-a, grupo-b)
GROUP_NAME=grupo-a

# Perfil de sesion del laboratorio (default | demo | team-a | team-b)
SESSION_PROFILE=team-a

# Carpeta donde los hooks BDD guardan la evidencia nombrada con el ID del escenario
EVIDENCE_DIR=grupos/grupo-05-tarjetas-credito-debito/evidence/semana-05

# Ajustes de ejecucion BDD
HEADED=false
STEP_TIMEOUT_MS=75000
RATE_LIMIT_WAIT_MS=20000
