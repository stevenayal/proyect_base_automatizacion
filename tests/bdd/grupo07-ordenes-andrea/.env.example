# Variables que necesita el workspace del Grupo 07 (Tarea 6 - BDD).
# Copia este contenido a un archivo `.env` en la RAIZ del repo
# (el `.env` de raiz esta en .gitignore y no se commitea) o definilas
# como environment variables en el job de CI.
#
# El cucumber.js del workspace falla a proposito si falta SANDBOX_API_KEY.
# Las URLs son las del sandbox publico (mismo fallback que el resto del repo).

BASE_URL=https://aiquaa-sandbox-web.vercel.app
SANDBOX_API_URL=https://aiquaa-sandbox-api.vercel.app
SANDBOX_API_KEY=sbx_demo_<clave-demo-del-sandbox>