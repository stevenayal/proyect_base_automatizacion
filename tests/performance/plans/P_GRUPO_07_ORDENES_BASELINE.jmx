props.remove('g7.ordenes.state')
def fail = { String reason -&gt;
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode('CONFIGURATION_ERROR')
    SampleResult.setResponseMessage(reason)
    ctx.getEngine().stopTest(true)
}
def key = System.getenv('API_KEY')
if (key == null || key.trim().isEmpty() || key.contains('\r') || key.contains('\n')) {
    fail('A valid external API_KEY environment variable is required')
    return
}
if (props.getProperty('g7.requirementId') != 'PERF-ORDENES-GET-001' ||
    props.getProperty('g7.targetRpm') != '10' ||
    props.getProperty('g7.ceilingRpm') != '30' ||
    props.getProperty('g7.durationSeconds') != '120' ||
    props.getProperty('g7.rampUpSeconds') != '15' ||
    props.getProperty('g7.workerSlots') != '18' ||
    props.getProperty('httpclient4.retrycount') != '0' ||
    props.getProperty('httpclient4.request_sent_retry_enabled') != 'false') {
    fail('Load the Grupo 07 properties unchanged; scenario or retry settings are invalid')
    return
}
// One process only: all one-shot workers share this gate and epoch.
props.put('g7.ordenes.state', [lock: new Object(), startNs: 0L, lastReleaseNs: 0L])
SampleResult.setSuccessful(true)
SampleResult.setIgnore()
