<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="G7 finish within total observation window" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">vars.remove('g7.apiKey')
def state = props.get('g7.ordenes.state')
if (state != null &amp;&amp; state.startNs != 0L) {
    long end = state.startNs + 120_000_000_000L
    try {
        long remaining
        while ((remaining = end - System.nanoTime()) &gt; 0L) {
            java.util.concurrent.TimeUnit.NANOSECONDS.sleep(Math.min(remaining, 100_000_000L))
        }
    } catch (InterruptedException ignored) {
        Thread.currentThread().interrupt()
    }
}
SampleResult.setSuccessful(true)
SampleResult.setIgnore()
