<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="G7 arrival gate" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">// Ignored control sample: waiting is NOT included in HTTP elapsed time.
vars.put('g7.dispatch', 'false')
def state = props.get('g7.ordenes.state')
def key = System.getenv('API_KEY')
def fail = { String reason -&gt;
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode('SCHEDULE_ERROR')
    SampleResult.setResponseMessage(reason)
}
if (state == null || key == null || key.trim().isEmpty()) {
    fail('Validated setup state and external API_KEY are required')
    ctx.getEngine().stopTest(true)
    return
}
long start
synchronized (state.lock) {
    if (state.startNs == 0L) state.startNs = System.nanoTime()
    start = state.startNs
}
int ordinal = ctx.getThreadNum() + 1
// Integral of a linear 0 -&gt; 1/6 RPS ramp over 15 s = 1.25 arrivals.
// Release when integrated arrivals reaches each integer, then every 6 s.
double offsetSeconds = ordinal &lt;= 1.25d ?
    Math.sqrt(180.0d * ordinal) : 15.0d + (ordinal - 1.25d) * 6.0d
long due = start + Math.round(offsetSeconds * 1_000_000_000d)
long deadline = start + 120_000_000_000L
def waitUntil = { long target -&gt;
    long remaining
    while ((remaining = target - System.nanoTime()) &gt; 0L) {
        java.util.concurrent.TimeUnit.NANOSECONDS.sleep(Math.min(remaining, 100_000_000L))
    }
}
try {
    waitUntil(due)
    synchronized (state.lock) {
        // A late worker cannot cause a catch-up burst. Small scheduling jitter
        // is tolerated, but missed slots are visible failures and are not retried.
        long release = Math.max(due, state.lastReleaseNs == 0L ?
            due : state.lastReleaseNs + 6_000_000_000L)
        if (release &gt; due + 500_000_000L || System.nanoTime() &gt; due + 500_000_000L) {
            fail('Arrival slot missed; request skipped to prevent catch-up traffic')
            return
        }
        waitUntil(release)
        long now = System.nanoTime()
        if (now &gt;= deadline || now &gt; due + 500_000_000L) {
            fail('Arrival deadline missed; request skipped')
            return
        }
        state.lastReleaseNs = now
        // Split the remaining wall-clock budget between connect and response.
        // These are execution bounds, NOT response-time acceptance thresholds.
        long budgetMs = Math.max(2L, (deadline - now).intdiv(1_000_000L) - 100L)
        long connectMs = Math.min(10_000L, Math.max(1L, budgetMs.intdiv(5L)))
        long responseMs = Math.min(30_000L, Math.max(1L, budgetMs - connectMs))
        vars.put('g7.connectMs', Long.toString(connectMs))
        vars.put('g7.responseMs', Long.toString(responseMs))
        vars.put('g7.apiKey', key)
        vars.put('g7.dispatch', 'true')
    }
    SampleResult.setSuccessful(true)
    SampleResult.setIgnore()
} catch (InterruptedException ignored) {
    Thread.currentThread().interrupt()
    fail('Arrival scheduling interrupted; no request dispatched')
}
</stringProp></JSR223Sampler><hashTree/>
