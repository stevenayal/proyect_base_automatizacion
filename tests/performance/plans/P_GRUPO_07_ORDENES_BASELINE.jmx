<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="G7 enforce total duration" enabled="true">
<stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp>
<stringProp name="script">// End the workload at the shared 120-second deadline, including in-flight HTTP.
SampleResult.setSuccessful(true)
SampleResult.setIgnore()
def state = props.get('g7.ordenes.state')
if (state == null) {
    ctx.getEngine().stopTest(true)
    return
}
try {
    long start = 0L
    while (start == 0L) {
        synchronized (state.lock) { start = state.startNs }
        if (start == 0L) Thread.sleep(10L)
    }
    long deadline = start + 120_000_000_000L
    long remaining
    while ((remaining = deadline - System.nanoTime()) &gt; 0L) {
        java.util.concurrent.TimeUnit.NANOSECONDS.sleep(Math.min(remaining, 100_000_000L))
    }
    ctx.getEngine().stopTest(true)
} catch (InterruptedException ignored) {
    Thread.currentThread().interrupt()
}
</stringProp>
</JSR223Sampler><hashTree/>
