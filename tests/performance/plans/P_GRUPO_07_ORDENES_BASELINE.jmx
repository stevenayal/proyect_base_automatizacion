<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="HTTP 200 and orders contract" enabled="true">
<stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">// Keep diagnostics generic: never include response data or headers.
try {
    if (prev.getResponseCode() != '200') {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage('Expected HTTP status 200')
    } else {
        def body = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
        boolean valid = body instanceof Map &amp;&amp; body.containsKey('data') &amp;&amp;
            body.data instanceof List &amp;&amp; body.data.size() &lt;= 100 &amp;&amp;
            body.data.every { entry -&gt; entry instanceof Map &amp;&amp; !entry.containsKey('items') }
        if (!valid) {
            AssertionResult.setFailure(true)
            AssertionResult.setFailureMessage('Expected top-level data array of at most 100 order objects without items')
        }
    }
} catch (Exception ignored) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Response must be valid JSON matching the orders contract')
}
</stringProp>
</JSR223Assertion><hashTree/>
</hashTree>
