</stringProp></JSR223PreProcessor><hashTree/></hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="Hay factura en el lote" enabled="true"><stringProp name="IfController.condition">${__jexl3(&quot;${G3_hay}&quot; == &quot;1&quot;)}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Repetir solo si hubo 429" enabled="true"><stringProp name="WhileController.condition">${__jexl3(&quot;${G3_otra}&quot; == &quot;1&quot;)}</stringProp></WhileController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="F6 - DELETE /api/v1/facturas/{id} (dar de baja)" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/api/v1/facturas/${G3_id}</stringProp><stringProp name="HTTPSampler.method">DELETE</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree><ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Ritmo: rpm requests por minuto (propiedad rpm)" enabled="true"><intProp name="calcMode">0</intProp><stringProp name="throughput">${__P(rpm,10)}</stringProp></ConstantThroughputTimer><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Reintento 429 y registro" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Reintento ante 429 (otros grupos comparten la API key). La muestra con 429 se
// renombra &quot;429 - ...&quot; para contarla aparte: no ensucia las métricas del endpoint.
// Si se agotan los reintentos, el último 429 conserva el nombre del endpoint y
// cuenta como error suyo (no se esconde).
String codigo = prev.getResponseCode();
int intento = Integer.parseInt(vars.get(&quot;G3_intento&quot;) == null ? &quot;0&quot; : vars.get(&quot;G3_intento&quot;));
int maximo = Integer.parseInt(props.getProperty(&quot;maxReintentos429&quot;, &quot;3&quot;));
String endpoint = prev.getSampleLabel();
if (&quot;429&quot;.equals(codigo)) {
    if (intento &lt; maximo) {
        prev.setSampleLabel(&quot;429 - &quot; + endpoint);
        long espera = 10L;
        String cabeceras = prev.getResponseHeaders();
        java.util.regex.Matcher m = java.util.regex.Pattern.compile(&quot;(?im)^Retry-After:\\s*(\\d+)&quot;).matcher(cabeceras == null ? &quot;&quot; : cabeceras);
        if (m.find()) {
            espera = Long.parseLong(m.group(1));
        }
        long tope = Long.parseLong(props.getProperty(&quot;esperaMax429&quot;, &quot;60&quot;));
        if (espera &gt; tope) {
            espera = tope;
        }
        if (espera &lt; 1L) {
            espera = 1L;
        }
        vars.put(&quot;G3_intento&quot;, String.valueOf(intento + 1));
        vars.put(&quot;G3_otra&quot;, &quot;1&quot;);
        log.warn(&quot;[G3] 429 en &quot; + endpoint + &quot;: reintento &quot; + (intento + 1) + &quot; de &quot; + maximo + &quot; en &quot; + espera + &quot; s&quot;);
        Thread.sleep(espera * 1000L);
        return;
    }
    log.warn(&quot;[G3] 429 sin reintentos disponibles: cuenta como error de &quot; + endpoint);
}
vars.put(&quot;G3_otra&quot;, &quot;0&quot;);

// F6 y limpieza: 204 (baja) o 404 (ya no existe) sacan la factura de pendientes.
String cod = prev.getResponseCode();
if (&quot;204&quot;.equals(cod) || &quot;404&quot;.equals(cod)) {
    java.util.List lote = (java.util.List) props.get(&quot;G3_FACTURAS&quot;);
    int idx = Integer.parseInt(vars.get(&quot;G3_idx&quot;));
    ((java.util.Map) lote.get(idx)).put(&quot;baja&quot;, &quot;si&quot;);
}
</stringProp></JSR223PostProcessor><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status 204" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="204">204</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree></hashTree></hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="P - Pausa antes de la saturacion" enabled="true"><stringProp name="TestPlan.comments">Deja vaciar la ventana del rate limit. Con satHilos=0 no corre.</stringProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__jexl3(${__P(satHilos,0)} &gt; 0 ? 1 : 0)}</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><TestAction guiclass="TestActionGui" testclass="TestAction" testname="Esperar pausaSaturacion segundos" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">${__jexl3(${__P(pausaSaturacion,90)} * 1000)}</stringProp></TestAction><hashTree/></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="S - Saturacion de lecturas (informativa)" enabled="true"><stringProp name="TestPlan.comments">Solo lecturas: un 429 no deja facturas creadas. Sin reintentos: buscamos el techo.</stringProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">true</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(satHilos,0)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(satRampa,10)}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(satDuracion,90)}</stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S - GET /api/v1/facturas/{id} (consultar)" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/api/v1/facturas/${__P(G3_ID_LECTURA,1)}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="200">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="S - GET /api/v1/facturas?estado=pendiente (listar)" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/api/v1/facturas?estado=pendiente</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="200">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree></hashTree><PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="99 - Limpieza (facturas que quedaron activas)" enabled="true"><stringProp name="TestPlan.comments">Corre al final y también si se corta la prueba (tearDown_on_shutdown).</stringProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></PostThreadGroup><hashTree><TestAction guiclass="TestActionGui" testclass="TestAction" testname="pendientes" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">0</stringProp></TestAction><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Preparar pendientes" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Busca la próxima factura del lote que siga activa (F6 no la dio de baja).
vars.put(&quot;G3_otra&quot;, &quot;1&quot;);
vars.put(&quot;G3_intento&quot;, &quot;0&quot;);
java.util.List lote = (java.util.List) props.get(&quot;G3_FACTURAS&quot;);
vars.put(&quot;G3_hay&quot;, &quot;0&quot;);
if (lote != null) {
    for (int i = 0; i &lt; lote.size(); i++) {
        java.util.Map f = (java.util.Map) lote.get(i);
        if (&quot;no&quot;.equals(f.get(&quot;baja&quot;))) {
            vars.put(&quot;G3_idx&quot;, String.valueOf(i));
            vars.put(&quot;G3_id&quot;, (String) f.get(&quot;id&quot;));
            vars.put(&quot;G3_hay&quot;, &quot;1&quot;);
            log.info(&quot;[G3] limpieza: factura &quot; + f.get(&quot;id&quot;) + &quot; sigue activa&quot;);
            break;
        }
    }
}
</stringProp></JSR223PreProcessor><hashTree/></hashTree><WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Mientras quede alguna activa" enabled="true"><stringProp name="WhileController.condition">${__jexl3(&quot;${G3_hay}&quot; == &quot;1&quot;)}</stringProp></WhileController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="99 - Limpieza - DELETE /api/v1/facturas/{id}" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/api/v1/facturas/${G3_id}</stringProp><stringProp name="HTTPSampler.method">DELETE</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree><ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Ritmo: rpm requests por minuto (propiedad rpm)" enabled="true"><intProp name="calcMode">0</intProp><stringProp name="throughput">${__P(rpm,10)}</stringProp></ConstantThroughputTimer><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Marcar y buscar la siguiente" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">// Limpieza: ante 429 se reintenta la misma factura hasta 3 veces; después se sigue
// con la próxima (se avisa en el log) para no quedar en un bucle infinito.
String cod = prev.getResponseCode();
int intento = Integer.parseInt(vars.get(&quot;G3_intento&quot;) == null ? &quot;0&quot; : vars.get(&quot;G3_intento&quot;));
if (&quot;429&quot;.equals(cod)) {
    prev.setSampleLabel(&quot;429 - &quot; + prev.getSampleLabel());
    if (intento &lt; 3) {
        vars.put(&quot;G3_intento&quot;, String.valueOf(intento + 1));
        Thread.sleep(10000L);
        return;
    }
    log.warn(&quot;[G3] limpieza: la factura &quot; + vars.get(&quot;G3_id&quot;) + &quot; puede haber quedado activa (429)&quot;);
}
java.util.List hechas = (java.util.List) props.get(&quot;G3_FACTURAS&quot;);
((java.util.Map) hechas.get(Integer.parseInt(vars.get(&quot;G3_idx&quot;)))).put(&quot;baja&quot;, &quot;si&quot;);

// Busca la próxima factura del lote que siga activa (F6 no la dio de baja).
vars.put(&quot;G3_otra&quot;, &quot;1&quot;);
vars.put(&quot;G3_intento&quot;, &quot;0&quot;);
java.util.List lote = (java.util.List) props.get(&quot;G3_FACTURAS&quot;);
vars.put(&quot;G3_hay&quot;, &quot;0&quot;);
if (lote != null) {
    for (int i = 0; i &lt; lote.size(); i++) {
        java.util.Map f = (java.util.Map) lote.get(i);
        if (&quot;no&quot;.equals(f.get(&quot;baja&quot;))) {
            vars.put(&quot;G3_idx&quot;, String.valueOf(i));
            vars.put(&quot;G3_id&quot;, (String) f.get(&quot;id&quot;));
            vars.put(&quot;G3_hay&quot;, &quot;1&quot;);
            log.info(&quot;[G3] limpieza: factura &quot; + f.get(&quot;id&quot;) + &quot; sigue activa&quot;);
            break;
        }
    }
}
</stringProp></JSR223PostProcessor><hashTree/></hashTree></hashTree></hashTree></hashTree></hashTree></jmeterTestPlan>
