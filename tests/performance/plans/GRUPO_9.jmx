        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Caso Crear Movimiento">
          <stringProp name="TestPlan.comments">https://aiquaa-sandbox-api.vercel.app</stringProp>
