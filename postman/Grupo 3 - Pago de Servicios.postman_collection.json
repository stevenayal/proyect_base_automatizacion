    {
      "name": "Pago exitoso de factura de ANDE",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 1. Obtener UsuarioID desde el entorno",
              "var rawUsuarioId = pm.environment.get(\"UsuarioID\");",
              "var usuarioIdNum = parseInt(rawUsuarioId, 10);",
              "",
              "if (isNaN(usuarioIdNum)) {",
              "    console.warn(\"UsuarioID no está configurado en el entorno o es inválido. Usando valor por defecto: 1\");",
              "    usuarioIdNum = 1;",
              "}",
              "",
              "// 2. Construir la consulta SQL",
              "const queryBody = {",
              "    sql: \"SELECT id FROM facturas WHERE proveedor = $1 AND estado IN ($2, $3) AND usuario_id = $4 LIMIT 1\",",
              "    params: [\"ANDE\", \"pendiente\", \"vencida\", usuarioIdNum]",
              "};",
              "",
              "// 3. Obtener baseUrl y apiKey",
              "var baseUrl = pm.collectionVariables.get(\"baseUrl\") || pm.environment.get(\"baseUrl\");",
              "var apiKey = pm.collectionVariables.get(\"apiKey\") || pm.environment.get(\"apiKey\");",
              "",
              "// 4. Ejecutar la petición SQL previa (con x-api-key)",
              "pm.sendRequest({",
              "    url: baseUrl + \"/api/v1/sql/select\",",
              "    method: 'POST',",
              "    header: {",
              "        'Content-Type': 'application/json',",
              "        'x-api-key': apiKey",
              "    },",
              "    body: {",
              "        mode: 'raw',",
              "        raw: JSON.stringify(queryBody)",
              "    }",
              "}, function (err, res) {",
              "    if (err) {",
              "        console.error(\"Error al ejecutar Pre-request SQL:\", err);",
              "        pm.collectionVariables.set(\"ID_tabla\", 0);",
              "        return;",
              "    }",
              "",
              "    var responseData = res.json();",
              "",
              "    // 5. Validar la respuesta y extraer el ID",
              "    if (responseData && responseData.data && responseData.data.length > 0) {",
              "        var rawId = responseData.data[0].id;",
              "        var idNumerico = parseInt(rawId, 10);",
              "",
              "        if (!isNaN(idNumerico)) {",
              "            pm.collectionVariables.set(\"ID_tabla\", idNumerico);",
              "            console.log(\"✓ ID_tabla asignado con éxito:\", idNumerico);",
              "        } else {",
              "            console.error(\"El id retornado no es interpretable como número:\", rawId);",
              "            pm.collectionVariables.set(\"ID_tabla\", 0);",
              "        }",
              "    } else {",
              "        console.warn(\"No se encontraron facturas pendientes/vencidas de ANDE para el usuario:\", usuarioIdNum);",
              "        console.warn(\"Respuesta SQL:\", JSON.stringify(responseData));",
              "        pm.collectionVariables.set(\"ID_tabla\", 0);",
              "    }",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Validar que la API responda200 OK\r",
              "pm.test(\"Pago confirmado correctamente\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Validar que factura cambia a estado pagada\r",
              "pm.test(\"El estado de la factura se actualizó a pagada\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.data.factura.estado).to.eql(\"pagada\");\r",
              "});\r",
              "\r",
              "// Validar que el pago fue procesado correctamente\r",
              "pm.test(\"Se generó el comprobante de pago en estado 'procesado'\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.data.pago.estado).to.eql(\"procesado\");\r",
              "});\r",
              "\r",
              "// Validar consistencia de datos entre Factura y Pago\r",
              "pm.test(\"El monto pagado coincide con el monto de la factura\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.data.pago.monto).to.eql(jsonData.data.factura.monto);\r",
              "    pm.expect(jsonData.data.pago.factura_id).to.eql(jsonData.data.factura.id);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
