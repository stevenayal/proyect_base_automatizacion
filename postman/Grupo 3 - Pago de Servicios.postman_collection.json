          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sql\": \"UPDATE facturas SET estado = $1 WHERE usuario_id = $2 AND proveedor = $3\",\n  \"params\": [\n    \"pagada\",\n    \"{{UsuarioID}}\",\n    \"ANDE\"\n  ]\n}",
