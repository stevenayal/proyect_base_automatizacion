    {
      "name": "Pago exitoso factura ANDE todos los pendientes",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Validar que la API responda200 OK\r",
              "pm.test(\"Pago confirmado correctamente\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Validar que rowCount sea un número mayor a 0\r",
              "pm.test(\"Al menos una factura cambia a pagada\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.rowCount).to.be.above(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
