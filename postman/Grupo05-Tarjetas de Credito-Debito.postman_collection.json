    {
      "name": "Emitir tarjeta",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set(\"tipo_tarjeta\", \"credito\");\r",
              "pm.environment.set(\"marca_tarjeta\", \"visa\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. El codigo de respuesta es 201 (Created)\r",
              "pm.test(\"Codigo de respuesta es 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// 2. El tiempo de respuesta es aceptable\r",
              "pm.test(\"Tiempo de respuesta menor a 3000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
              "});\r",
              "\r",
              "\r",
              "// 3. El response tiene los campos requeridos\r",
              "pm.test(\"El cuerpo de la respuesta tiene los campos requeridos\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.data).to.have.property(\"id\");\r",
              "    pm.expect(jsonData.data).to.have.property(\"usuario_id\");\r",
              "    pm.expect(jsonData.data).to.have.property(\"tipo\");\r",
              "    pm.expect(jsonData.data).to.have.property(\"marca\");\r",
              "    pm.expect(jsonData.data).to.have.property(\"estado\");\r",
              "    pm.expect(jsonData.data).to.have.property(\"numero_enmascarado\");\r",
              "});\r",
              "\r",
              "// 4. El tipo de tarjeta emitida coincide con la seteada en la variable en el request inicial\r",
              "pm.test(\"Tipo de tarjeta es 'credito'\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.data.tipo).to.eql(\"credito\");\r",
              "});\r",
              "\r",
              "// 5. La marca de la tarjeta emitida coincide con la seteada en la variable en el request inicial\r",
              "pm.test(\"Marca de la tarjeta es 'visa'\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.data.marca).to.eql(\"visa\");\r",
              "});\r",
              "\r",
              "// 6. Se creo correctamente el card_id\r",
              "pm.test(\"El id de la tarjeta esta presente y no es null\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.data.id).to.not.be.null;\r",
              "    pm.expect(jsonData.data.id).to.not.be.undefined;\r",
              "});\r",
              "\r",
              "// 7. Verificamos que el número de tarjeta esté presente y no esté vacío\r",
              "pm.test(\"El numero de la tarjeta esta presente y no esta vacio\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.data.numero_enmascarado).to.not.be.null;\r",
              "    pm.expect(jsonData.data.numero_enmascarado).to.not.be.undefined;\r",
              "    pm.expect(String(jsonData.data.numero_enmascarado).length).to.be.above(0);\r",
              "});\r",
              "\r",
              "// 8. Guardamos tarjeta_id en una variable en caso de necesitar usarla luego\r",
              "const jsonData = pm.response.json();\r",
              "if (jsonData && jsonData.id) {\r",
              "    pm.environment.set(\"tarjeta_id\", jsonData.id);\r",
              "    console.log(\"tarjeta_id saved:\", jsonData.id);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
