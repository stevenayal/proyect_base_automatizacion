  "item": [
    {
      "name": "POST - Transferencia a cuenta inactiva (Rechazo)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 0. Inicializar utils si no está definido\r",
              "if (typeof utils === \"undefined\") {\r",
              "    utils = {\r",
              "        bodySqlRest: function (sql, params) {\r",
              "            const base = pm.environment.get(\"baseUrl\");\r",
              "            const key = pm.environment.get(\"apiKey\");\r",
              "            return {\r",
              "                url: base + \"/api/v1/sql/select\",\r",
              "                method: \"POST\",\r",
              "                header: {\r",
              "                    \"Content-Type\": \"application/json\",\r",
              "                    \"x-api-key\": key\r",
              "                },\r",
              "                body: {\r",
              "                    mode: \"raw\",\r",
              "                    raw: JSON.stringify({ sql: sql, params: params || [] })\r",
              "                }\r",
              "            };\r",
              "        }\r",
              "    };\r",
              "}\r",
              "\r",
              "// 1. Guardar la cantidad total de transferencias\r",
              "const reqCount = utils.bodySqlRest(\"SELECT COUNT(*) AS total FROM transferencias\");\r",
              "\r",
              "pm.sendRequest(reqCount, (err, res) => {\r",
              "    if (!err && res && res.json) {\r",
              "        pm.variables.set(\"totalAntes\", res.json().data[0].total);\r",
              "    }\r",
              "    \r",
              "    // 2. Buscar cuenta ORIGEN activa con saldo mayor o igual a 5.000.000\r",
              "    const reqOrigen = utils.bodySqlRest(\"SELECT id FROM cuentas WHERE activa = true AND saldo >= 5000000 LIMIT 1\");\r",
              "    pm.sendRequest(reqOrigen, (errOrigen, resOrigen) => {\r",
              "        const dataOrigen = resOrigen?.json()?.data;\r",
              "        \r",
              "        if (errOrigen || !dataOrigen || dataOrigen.length === 0) {\r",
              "            pm.expect.fail(\"PRE-CONDICIÓN FALLIDA: No hay ninguna cuenta activa con saldo >= 5.000.000.\");\r",
              "        } else {\r",
              "            const origenId = dataOrigen[0].id;\r",
              "            pm.environment.set(\"cuentaOrigenId\", origenId);\r",
              "            console.log(\"Cuenta Origen asignada:\", origenId);\r",
              "        }\r",
              "\r",
              "        // 3. Buscar cuenta DESTINO inactiva\r",
              "        const reqDestino = utils.bodySqlRest(\"SELECT id FROM cuentas WHERE activa = false LIMIT 1\");\r",
              "        pm.sendRequest(reqDestino, (errDestino, resDestino) => {\r",
              "            const dataDestino = resDestino?.json()?.data;\r",
              "            \r",
              "            if (errDestino || !dataDestino || dataDestino.length === 0) {\r",
              "                pm.expect.fail(\"PRE-CONDICIÓN FALLIDA: No hay ninguna cuenta inactiva en la BD.\");\r",
              "            } else {\r",
              "                const destinoId = dataDestino[0].id;\r",
              "                pm.environment.set(\"cuentaDestinoBloqueadaId\", destinoId);\r",
              "                console.log(\"Cuenta Destino Inactiva asignada:\", destinoId);\r",
              "            }\r",
              "        });\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Exigir código de error de rechazo\r",
              "pm.test(\"La API rechazó la transferencia a cuenta bloqueada\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);\r",
              "});\r",
              "\r",
              "// Validar que la BD no haya sufrido cambios\r",
              "const reqCountPost = utils.bodySqlRest(\"SELECT COUNT(*) AS total FROM transferencias\");\r",
              "pm.sendRequest(reqCountPost, (err, res) => {\r",
              "    pm.test(\"La BD NO registró la transferencia\", function () {\r",
              "        const totalDespues = res.json().data[0].total;\r",
              "        const totalAntes = pm.variables.get(\"totalAntes\");\r",
              "        pm.expect(Number(totalDespues)).to.eql(Number(totalAntes));\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "sbx_demo_f581ca21e68a347288c94d71",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"cuentaOrigenId\": {{cuentaOrigenId}},\r\n  \"cuentaDestinoId\": {{cuentaDestinoBloqueadaId}},\r\n  \"monto\": {{monto}},\r\n  \"descripcion\": \"Transferencia a cuenta Inactiva\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/transferencias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "transferencias"
          ]
        }
      },
      "response": []
    }
  ],
