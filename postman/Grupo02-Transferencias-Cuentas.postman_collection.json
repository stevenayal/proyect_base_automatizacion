  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (typeof utils === 'undefined') {",
          "    utils = {",
          "        bodySqlRest: function (sql, params) {",
          "            const base = pm.environment.get('baseUrl') || pm.collectionVariables.get('baseUrl');",
          "            const key = pm.environment.get('apiKey') || pm.collectionVariables.get('apiKey');",
          "            return {",
          "                url: base + '/api/v1/sql/select',",
          "                method: 'POST',",
          "                header: {",
          "                    'Content-Type': 'application/json',",
          "                    'x-api-key': key",
          "                },",
          "                body: {",
          "                    mode: 'raw',",
          "                    raw: JSON.stringify({ sql: sql, params: params || [] })",
          "                }",
          "            };",
          "        },",
          "        rows: function (res) {",
          "            if (!res) return [];",
          "            try {",
          "                const body = typeof res.json === 'function' ? res.json() : res;",
          "                if (Array.isArray(body)) return body;",
          "                if (body && Array.isArray(body.data)) return body.data;",
          "                if (body && Array.isArray(body.rows)) return body.rows;",
          "                if (body && body.data && Array.isArray(body.data.rows)) return body.data.rows;",
          "                return [];",
          "            } catch (e) {",
          "                return [];",
          "            }",
          "        },",
          "        sql: function (query, params) {",
          "            const self = this;",
          "            return new Promise(function (resolve, reject) {",
          "                pm.sendRequest(self.bodySqlRest(query, params), function (err, res) {",
          "                    if (err) return reject(err);",
          "                    if (res && res.code >= 400) {",
          "                        return reject(new Error('SQL REST HTTP ' + res.code + ' ' + res.text()));",
          "                    }",
          "                    resolve(self.rows(res));",
          "                });",
          "            });",
          "        },",
          "        applyCuentas: function (origen, destino) {",
          "            pm.collectionVariables.set('cuentaOrigenId', String(origen.id));",
          "            pm.collectionVariables.set('cuentaDestinoId', String(destino.id));",
          "            pm.variables.set('saldoOrigenAntes', String(origen.saldo));",
          "            pm.variables.set('saldoDestinoAntes', String(destino.saldo));",
          "        },",
          "        snapshotCount: function () {",
          "            return this.sql('SELECT COUNT(*) AS total FROM transferencias').then(function (rows) {",
          "                const total = rows[0] && rows[0].total != null ? rows[0].total : 0;",
          "                pm.variables.set('totalAntes', String(total));",
          "                return Number(total);",
          "            });",
          "        },",
          "        loadDosActivas: function () {",
          "            return this.sql(",
          "                'SELECT id, saldo, activa FROM cuentas WHERE activa = true AND saldo > 0 ORDER BY saldo DESC LIMIT 2'",
          "            ).then(function (rows) {",
          "                if (!rows || rows.length < 2) {",
          "                    throw new Error('PRE-CONDICIÓN SQL: se necesitan 2 cuentas activas con saldo > 0.');",
          "                }",
          "                return { origen: rows[0], destino: rows[1] };",
          "            });",
          "        },",
          "        prepareEscenario: function (tipo) {",
          "            const self = this;",
          "            return self.snapshotCount().then(function () {",
          "                if (tipo === 'blocked') {",
          "                    return self.sql(",
          "                        'SELECT id, saldo FROM cuentas WHERE activa = true AND saldo > 0 ORDER BY saldo DESC LIMIT 1'",
          "                    ).then(function (activas) {",
          "                        if (!activas[0]) throw new Error('PRE-CONDICIÓN SQL: no hay origen activo con saldo.');",
          "                        const origen = activas[0];",
          "                        return self.sql(",
          "                            'SELECT id, saldo, activa FROM cuentas WHERE activa = false AND id <> $1 LIMIT 1',",
          "                            [Number(origen.id)]",
          "                        ).then(function (inactivas) {",
          "                            if (!inactivas[0]) throw new Error('PRE-CONDICIÓN SQL: no hay cuenta inactiva/bloqueada.');",
          "                            const destino = inactivas[0];",
          "                            self.applyCuentas(origen, destino);",
          "                            pm.collectionVariables.set('cuentaBloqueadaId', String(destino.id));",
          "                            const monto = Math.max(1, Math.min(1000, Math.floor(Number(origen.saldo)) || 1));",
          "                            pm.collectionVariables.set('montoValido', String(monto));",
          "                            console.log('SQL blocked | origen=', origen.id, 'destino=', destino.id, 'monto=', monto);",
          "                        });",
          "                    });",
          "                }",
          "",
          "                if (tipo === 'exact') {",
          "                    return self.sql(",
          "                        'SELECT id, saldo FROM cuentas WHERE activa = true AND saldo > 0 ORDER BY saldo ASC LIMIT 1'",
          "                    ).then(function (chicas) {",
          "                        if (!chicas[0]) throw new Error('PRE-CONDICIÓN SQL: no hay cuenta activa con saldo para vaciar.');",
          "                        const origen = chicas[0];",
          "                        return self.sql(",
          "                            'SELECT id, saldo FROM cuentas WHERE activa = true AND id <> $1 ORDER BY saldo DESC LIMIT 1',",
          "                            [Number(origen.id)]",
          "                        ).then(function (destinos) {",
          "                            if (!destinos[0]) throw new Error('PRE-CONDICIÓN SQL: no hay destino activo distinto.');",
          "                            const destino = destinos[0];",
          "                            self.applyCuentas(origen, destino);",
          "                            pm.collectionVariables.set('montoExacto', String(origen.saldo));",
          "                            console.log('SQL exact | origen=', origen.id, 'saldo=', origen.saldo, 'destino=', destino.id);",
          "                        });",
          "                    });",
          "                }",
          "",
          "                if (tipo === 'same_account') {",
          "                    return self.sql(",
          "                        'SELECT id, saldo FROM cuentas WHERE activa = true AND saldo > 0 ORDER BY saldo DESC LIMIT 1'",
          "                    ).then(function (rows) {",
          "                        if (!rows[0]) throw new Error('PRE-CONDICIÓN SQL: no hay cuenta activa.');",
          "                        const origen = rows[0];",
          "                        self.applyCuentas(origen, origen);",
          "                        const monto = Math.max(1, Math.min(1000, Math.floor(Number(origen.saldo)) || 1));",
          "                        pm.collectionVariables.set('montoValido', String(monto));",
          "                        console.log('SQL same_account | id=', origen.id, 'monto=', monto);",
          "                    });",
          "                }",
          "",
          "                return self.loadDosActivas().then(function (par) {",
          "                    self.applyCuentas(par.origen, par.destino);",
          "                    const saldo = Number(par.origen.saldo);",
          "                    const montoValido = Math.max(1, Math.min(1000, Math.floor(saldo / 10) || 1));",
          "                    pm.collectionVariables.set('montoValido', String(montoValido));",
          "                    pm.collectionVariables.set('montoMayorAlSaldo', String(saldo + 50000));",
          "",
          "                    if (tipo === 'insufficient') {",
          "                        console.log('SQL insufficient | origen=', par.origen.id, 'saldo=', saldo, 'monto=', saldo + 50000);",
          "                    } else if (tipo === 'invalid_zero') {",
          "                        pm.collectionVariables.set('montoInvalido', '0');",
          "                        console.log('SQL invalid_zero | origen=', par.origen.id, 'destino=', par.destino.id);",
          "                    } else if (tipo === 'invalid_negative') {",
          "                        pm.collectionVariables.set('montoInvalido', '-1000');",
          "                        console.log('SQL invalid_negative | origen=', par.origen.id, 'destino=', par.destino.id);",
          "                    } else {",
          "                        console.log('SQL happy | origen=', par.origen.id, 'destino=', par.destino.id, 'monto=', montoValido);",
          "                    }",
          "                });",
          "            });",
          "        },",
          "        assertNoNuevaTransferencia: function () {",
          "            const totalAntes = pm.variables.get('totalAntes');",
          "            this.sql('SELECT COUNT(*) AS total FROM transferencias').then(function (rows) {",
          "                pm.test('SQL: no se insertó una transferencia nueva', function () {",
          "                    const total = rows[0] && rows[0].total;",
          "                    pm.expect(Number(total)).to.eql(Number(totalAntes));",
          "                });",
          "            });",
          "        },",
          "        assertNuevaTransferencia: function () {",
          "            const totalAntes = Number(pm.variables.get('totalAntes'));",
          "            this.sql('SELECT COUNT(*) AS total FROM transferencias').then(function (rows) {",
          "                pm.test('SQL: se registró al menos una transferencia nueva', function () {",
          "                    pm.expect(Number(rows[0].total)).to.be.at.least(totalAntes + 1);",
          "                });",
          "            });",
          "        },",
          "        assertSaldosSinCambio: function (origenId, destinoId) {",
          "            const saldoOrigenAntes = pm.variables.get('saldoOrigenAntes');",
          "            const saldoDestinoAntes = pm.variables.get('saldoDestinoAntes');",
          "            this.sql('SELECT id, saldo FROM cuentas WHERE id IN ($1, $2)', [Number(origenId), Number(destinoId)]).then(function (rows) {",
          "                pm.test('SQL: los saldos de origen y destino no cambiaron', function () {",
          "                    const origen = rows.find(function (r) { return String(r.id) === String(origenId); });",
          "                    const destino = rows.find(function (r) { return String(r.id) === String(destinoId); });",
          "                    if (origen) pm.expect(Number(origen.saldo)).to.eql(Number(saldoOrigenAntes));",
          "                    if (destino) pm.expect(Number(destino.saldo)).to.eql(Number(saldoDestinoAntes));",
          "                });",
          "            });",
          "        },",
          "        assertSaldosMovidos: function (origenId, destinoId, monto) {",
          "            const saldoOrigenAntes = Number(pm.variables.get('saldoOrigenAntes'));",
          "            const saldoDestinoAntes = Number(pm.variables.get('saldoDestinoAntes'));",
          "            this.sql('SELECT id, saldo FROM cuentas WHERE id IN ($1, $2)', [Number(origenId), Number(destinoId)]).then(function (rows) {",
          "                pm.test('SQL: el saldo origen baja y el destino sube en el monto', function () {",
          "                    const origen = rows.find(function (r) { return String(r.id) === String(origenId); });",
          "                    const destino = rows.find(function (r) { return String(r.id) === String(destinoId); });",
          "                    pm.expect(Number(origen.saldo)).to.eql(saldoOrigenAntes - Number(monto));",
          "                    pm.expect(Number(destino.saldo)).to.eql(saldoDestinoAntes + Number(monto));",
          "                });",
          "            });",
          "        }",
          "    };",
          "}"
        ]
      }
    },
