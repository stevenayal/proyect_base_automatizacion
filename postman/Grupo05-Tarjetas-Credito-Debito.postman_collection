    {
      "name": "Bloquear tarjeta",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 2000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has data object\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"data\");\r",
              "});\r",
              "\r",
              "pm.test(\"Card estado is 'bloqueada'\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.data.estado).to.eql(\"bloqueada\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains required card fields\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    const card = jsonData.data;\r",
              "    pm.expect(card).to.have.property(\"id\");\r",
              "    pm.expect(card).to.have.property(\"usuario_id\");\r",
              "    pm.expect(card).to.have.property(\"tipo\");\r",
              "    pm.expect(card).to.have.property(\"marca\");\r",
              "    pm.expect(card).to.have.property(\"numero_enmascarado\");\r",
              "    pm.expect(card).to.have.property(\"estado\");\r",
              "    pm.expect(card).to.have.property(\"activo\");\r",
              "});"
            ],
