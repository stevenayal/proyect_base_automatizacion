    {
      "name": "Escenario 7 (Claudio) - Edge Case - Rango maximo de 10 anios",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// BDD: Cuando selecciona un rango de fechas de 10 anios",
              "// Entonces el reporte se genera agrupando los datos sin dar error de tiempo de espera",
              "",
              "pm.test('Status code es 200 (sin timeout)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response time es aceptable para rango extendido (< 5000ms)', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});",
              "",
              "pm.test('Los datos vienen agrupados (agrupado = true)', function () {",
              "    var jsonData = pm.response.json();",
