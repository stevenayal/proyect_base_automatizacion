      "name": "Escenario 3 - Roles - Indicadores visibles segun rol",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// BDD: Given que el usuario tiene el rol '<rol>'",
              "// When accede al panel de reportes financieros",
              "// Then debe visualizar unicamente los indicadores '<indicadores_visibles>'",
              "",
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Los indicadores retornados coinciden con los esperados para el rol', function () {",
              "    var jsonData = pm.response.json();",
              "    var esperados = JSON.parse(pm.collectionVariables.get('indicadores_esperados_rol'));",
              "    pm.expect(jsonData.indicadores.sort()).to.eql(esperados.sort());",
              "});",
              "",
              "pm.test('No se exponen indicadores fuera del rol (control de acceso)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.indicadores).to.not.include.members(['configuracion_admin']);",
              "});"
            ]
          }
        }
      ],
