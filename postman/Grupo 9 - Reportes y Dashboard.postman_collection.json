    {
      "name": "Escenario 1 - Happy Path - Generar reporte financiero",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// BDD: Given el usuario esta en el modulo de reportes",
              "// When solicita generar un reporte financiero",
              "// Then el sistema debe generar y mostrar el reporte correctamente",
              "",
              "pm.test('Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('El reporte se genera correctamente (estado = generado)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.estado).to.eql('generado');",
              "});",
              "",
              "pm.test('El reporte incluye metricas y graficos', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('metricas');",
              "    pm.expect(jsonData).to.have.property('graficos');",
              "});",
              "",
              "pm.test('Validar que el nombre del usuario este dentro de la respuesta', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.usuario).to.eql(pm.collectionVariables.get('usuario'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
