      "name": "Escenario 2 - Caso Negativo - Reporte sin datos en rango de fechas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// BDD: When aplica un filtro de fechas donde no existen transacciones registradas",
              "// Then el sistema debe mostrar el mensaje 'No se encontraron datos para el periodo seleccionado'",
              "",
              "pm.test('Status code es 200 (respuesta controlada, no error de servidor)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Se muestra el mensaje de periodo sin datos', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.mensaje).to.eql(pm.collectionVariables.get('mensaje_sin_datos'));",
              "});",
              "",
              "pm.test('El arreglo de datos viene vacio', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an('array').that.is.empty;",
              "});"
            ]
          }
        }
