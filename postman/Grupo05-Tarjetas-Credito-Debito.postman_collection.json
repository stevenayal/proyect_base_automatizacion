    {
      "name": "E2E - Flujos con validacion SQL",
      "description": "Patron SQL REST dinamico (pre-request + post-response) sobre el endpoint de escritura PATCH /tarjetas/:id/bloquear y /activar. Usa el helper utils.bodySqlRest declarado en el Pre-request Script de la coleccion para consultar /api/v1/sql/select antes y despues de cada request y confirmar que el cambio de estado quedo realmente persistido en la BD, no solo que la API respondio bien. Los 2 primeros requests forman un ciclo (bloquear -> activar) sobre la tarjeta id=1 del seed, asi la corrida completa deja la BD en el mismo estado en que empezo. El tercero es el caso negativo: id de tarjeta inexistente.",
      "item": [
        {
          "name": "Bloquear tarjeta (UPDATE + validacion SQL)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "// Caso feliz: usa el default tarjetaId=1 que puso el Pre-request",
                  "// Script de la COLECCION. Valida la precondicion en la BD antes",
                  "// de mandar el PATCH: la tarjeta debe estar 'activa'.",
                  "const tarjetaId = Number(pm.collectionVariables.get(\"tarjetaId\"));",
                  "const request = utils.bodySqlRest(",
                  "  \"SELECT id, estado FROM tarjetas WHERE id = $1\",",
                  "  [tarjetaId]",
                  ");",
                  "pm.sendRequest(request, (err, res) => {",
                  "  if (err) {",
                  "    console.error(\"Pre-request SQL check fallo:\", err);",
                  "    return;",
                  "  }",
                  "  const row = (res.json().data || [])[0];",
                  "  console.log(\"Estado de la tarjeta antes del bloqueo:\", row && row.estado);",
                  "});",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"La respuesta trae la tarjeta con estado 'bloqueada'\", function () {",
                  "    pm.expect(body.data).to.have.property(\"id\");",
                  "    pm.expect(body.data.estado).to.eql(\"bloqueada\");",
                  "});",
                  "",
                  "const tarjetaId = Number(pm.collectionVariables.get(\"tarjetaId\"));",
                  "",
                  "// Post-request: vuelve a consultar la BD para confirmar que el",
                  "// UPDATE realmente quedo persistido, no solo que la API respondio 200.",
                  "const request = utils.bodySqlRest(",
                  "  \"SELECT id, estado FROM tarjetas WHERE id = $1\",",
                  "  [tarjetaId]",
                  ");",
                  "pm.sendRequest(request, (err, res) => {",
                  "  pm.test(\"La BD confirma la tarjeta con estado 'bloqueada'\", function () {",
                  "    if (err) throw err;",
                  "    const row = res.json().data[0];",
                  "    pm.expect(row, \"no se encontro la tarjeta en la BD\").to.not.be.undefined;",
                  "    pm.expect(row.estado).to.eql(\"bloqueada\");",
                  "  });",
                  "});",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tarjetas/{{tarjetaId}}/bloquear",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tarjetas",
                "{{tarjetaId}}",
                "bloquear"
              ]
            },
            "description": "Caso feliz. Pre-request: confirma que la tarjeta id=1 (seed) esta 'activa'. Post-request: relee la fila en la BD y valida estado='bloqueada'."
          },
          "response": []
        },
        {
          "name": "Activar tarjeta (UPDATE + validacion SQL)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "// Segunda mitad del ciclo: la tarjeta deberia estar 'bloqueada'",
                  "// (dejada asi por el request anterior). Valida la precondicion",
                  "// antes de mandar el PATCH de activacion.",
                  "const tarjetaId = Number(pm.collectionVariables.get(\"tarjetaId\"));",
                  "const request = utils.bodySqlRest(",
                  "  \"SELECT id, estado FROM tarjetas WHERE id = $1\",",
                  "  [tarjetaId]",
                  ");",
                  "pm.sendRequest(request, (err, res) => {",
                  "  if (err) {",
                  "    console.error(\"Pre-request SQL check fallo:\", err);",
                  "    return;",
                  "  }",
                  "  const row = (res.json().data || [])[0];",
                  "  console.log(\"Estado de la tarjeta antes de activar:\", row && row.estado);",
                  "});",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
