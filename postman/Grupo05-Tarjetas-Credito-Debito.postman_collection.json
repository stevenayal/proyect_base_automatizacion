  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request Script DE LA COLECCION. Corre antes de CADA request de",
          "// toda la coleccion.",
          "",
          "// 1) Helper reusable para consultar la BD via /api/v1/sql/select.",
          "if (typeof utils === \"undefined\") {",
          "  utils = {",
          "    bodySqlRest: function (sql, params) {",
          "      return {",
          "        url: pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/sql/select\",",
          "        method: \"POST\",",
          "        header: {",
          "          \"Content-Type\": \"application/json\",",
          "          \"x-api-key\": pm.collectionVariables.get(\"apiKey\")",
          "        },",
          "        body: {",
          "          mode: \"raw\",",
          "          raw: JSON.stringify({ sql: sql, params: params || [] })",
          "        }",
          "      };",
          "    }",
          "  };",
          "}",
          "",
          "// 2) Default de la variable que varia entre casos (id de tarjeta).",
          "//    Se resetea ANTES DE CADA request; el caso negativo sobreescribe",
          "//    SOLO esta variable en su propio Pre-request Script.",
          "pm.collectionVariables.set(\"tarjetaId\", 1);"
        ]
      }
    }
  ],
