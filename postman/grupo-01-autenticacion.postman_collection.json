{
	"info": {
		"_postman_id": "b1a2c3d4-e5f6-7890-abcd-1234567890cd",
		"name": "Grupo 01 - Autenticación y Acceso (Mariel Aquino)",
		"description": "Mapeo de escenarios BDD a APIs de AIQUAA",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 - Login Exitoso (Happy Path)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200 - Permite el ingreso\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Respuesta contiene sessionId y token activo\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"sessionId\");",
							"    pm.expect(jsonData.status).to.eql(\"active\");",
							"    pm.environment.set(\"sessionId\", jsonData.sessionId);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"candidateId\": \"{{candidateId}}\",\n  \"documento\": \"12345678\",\n  \"password\": \"ClaveSegura123!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/labs/admin/seed/{{candidateId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"labs",
						"admin",
						"seed",
						"{{candidateId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "02 - Recuperación Correo No Registrado (Caso Negativo)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 404 - Correo no encontrado\", function () {",
							"    pm.response.to.have.status(404);",
							"});",
							"",
							"pm.test(\"Devuelve mensaje de error esperado\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.error).to.eql(\"Correo no encontrado\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"no_registrado@ejemplo.com\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/forgot-password",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"forgot-password"
					]
				}
			},
			"response": []
		},
		{
			"name": "03 - Cierre Sesión Token Expirado (Edge Case)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 401 - Unauthorized\", function () {",
							"    pm.response.to.have.status(401);",
							"});",
							"",
							"pm.test(\"Valida mensaje de sesión invalidada\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.include(\"Token expirado\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer token_expirado_12345"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/auth/logout",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"logout"
					]
				}
			},
			"response": []
		}
	]
}