{
  "info": {
    "name": "Grupo 07 - Carrito de Compras (Regression)",
    "description": "Pruebas de regresion BDD para RF-G7-01..05. Ejecutar con Newman contra la API en vivo + DB qa_training.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiKey",
      "value": "REEMPLAZAR_CON_API_KEY_VALIDA"
    },
    {
      "key": "ordenId",
      "value": ""
    },
    {
      "key": "g7Cantidad",
      "value": 2,
