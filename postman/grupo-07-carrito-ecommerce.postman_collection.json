                  "    pm.expect(after).to.deep.equal(before);",
                  "  });",
                  "  console.log('G7-S3 rechazo', JSON.stringify({ antes: JSON.parse(pm.variables.get('g7Antes')), despues: after }));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/ordenes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": {{g7UsuarioId}},\n  \"items\": [\n    { \"producto\": \"{{g7Producto1}}\", \"cantidad\": {{g7Cantidad}}, \"precioUnitario\": 10.50 },\n    { \"producto\": \"{{g7Producto2}}\", \"cantidad\": 1, \"precioUnitario\": 5.25 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "RF-G7-02. BDD: No permitir confirmar una compra con cantidad cero de un producto. Negativo/limite inferior: SQL verifica que no se insertan filas identificadas por el marcador del intento."
          }
        }
