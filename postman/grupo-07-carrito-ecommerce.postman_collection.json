  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Semana 3 - RF-G7-02. Helper unico; configuracion con precedencia normal de Postman.",
          "utils = {",
          "  bodySqlRest: function (sql, params) {",
          "    return {",
          "      url: String(pm.variables.get('baseUrl')).replace(/\\/$/, '') + '/api/v1/sql/select',",
          "      method: 'POST',",
          "      header: { 'Content-Type': 'application/json', 'x-api-key': pm.variables.get('apiKey') },",
          "      body: { mode: 'raw', raw: JSON.stringify({ sql: sql, params: params || [] }) }",
          "    };",
          "  },",
          "  fail: function (pm, label, error) {",
          "    pm.test(label, function () { throw error; });",
          "    if (pm.info.eventName === 'prerequest') {",
          "      pm.execution.setNextRequest(null);",
          "      pm.execution.skipRequest();",
          "    }",
          "  },",
          "  sql: function (pm, label, sql, params, next) {",
          "    pm.sendRequest(utils.bodySqlRest(sql, params), function (err, res) {",
          "      let result;",
          "      try {",
          "        pm.expect(err, label + ': transporte').to.equal(null);",
          "        pm.expect(res.code, label + ': HTTP').to.equal(200);",
          "        result = res.json();",
          "        pm.expect(result.data, label + ': data').to.be.an('array');",
          "        pm.expect(result.rowCount, label + ': rowCount').to.equal(result.data.length);",
          "      } catch (error) { utils.fail(pm, label, error); return; }",
          "      pm.test(label + ' - SQL 200 y contrato valido', function () {",
          "        pm.expect(result.rowCount).to.equal(result.data.length);",
          "      });",
          "      try { next(result); } catch (error) { utils.fail(pm, label + ' - datos esperados', error); }",
          "    });",
          "  },",
          "  counts: function (pm, next) {",
          "    const products = [pm.variables.get('g7Producto1'), pm.variables.get('g7Producto2')];",
          "    utils.sql(pm, 'RF-G7-02 conteo ordenes', 'SELECT COUNT(*) AS total FROM ordenes WHERE producto = $1',",
          "      [products[0]], function (orders) {",
          "        utils.sql(pm, 'RF-G7-02 conteo items', 'SELECT COUNT(*) AS total FROM items_orden WHERE producto IN ($1, $2)',",
          "          products, function (items) {",
          "            const counts = { ordenes: Number(orders.data[0].total), items: Number(items.data[0].total) };",
          "            pm.expect(Number.isSafeInteger(counts.ordenes)).to.equal(true);",
          "            pm.expect(Number.isSafeInteger(counts.items)).to.equal(true);",
          "            next(counts);",
          "          });",
          "      });",
          "  }",
          "};",
          "// No altera los defaults ni el encadenamiento ordenId de la regresion existente.",
          "if (pm.info.requestName.indexOf('G7-S3 ') === 0) {",
          "  ['g7UsuarioId', 'g7OrdenId', 'g7Antes'].forEach(function (key) { pm.variables.unset(key); });",
          "  pm.collectionVariables.set('g7Cantidad', 2);",
          "  pm.variables.set('g7Cantidad', 2); // evita valores residuales o sombras del environment",
          "  const tag = 'G7-S3-' + pm.variables.replaceIn('{{$guid}}');",
          "  pm.variables.set('g7Producto1', tag + '-Teclado');",
          "  pm.variables.set('g7Producto2', tag + '-Mouse');",
          "}"
        ]
      }
    }
  ]
