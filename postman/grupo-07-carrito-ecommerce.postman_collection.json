          ],
          "path": [
            "api",
            "v1",
            "ordenes"
          ],
          "query": [
            {
              "key": "usuarioId",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('todas pertenecen al comprador 1', () => { j.data.forEach(o => pm.expect(Number(o.usuario_id)).to.equal(1)); });",
              "pm.test('orden ascendente por id', () => { for (let i=1;i<j.data.length;i++) pm.expect(Number(j.data[i].id)).to.be.above(Number(j.data[i-1].id)); });"
            ]
          }
        }
      ]
    },
