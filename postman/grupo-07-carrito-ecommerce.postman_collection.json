                  "    pm.expect(result.rowCount, 'Se necesita un usuario sembrado').to.equal(1);",
                  "    const usuarioId = Number(result.data[0].id);",
                  "    pm.expect(Number.isSafeInteger(usuarioId) && usuarioId > 0).to.equal(true);",
