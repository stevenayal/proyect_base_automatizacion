  "item": [
    {
      "name": "01 - Crear orden (checkout)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const statusCode = pm.response.code;\r",
              "const jsonData = pm.response.json();\r",
              "const errorMessage = jsonData.error;\r",
              "pm.collectionVariables.set('id', jsonData.data.id);\r",
              "if(statusCode === 201){\r",
              "    pm.test(\"El código de respuesta es 201 Created\",() => {\r",
              "        pm.response.to.have.status(201);\r",
              "    });\r",
              "    pm.test(\"La respuesta contiene el objeto 'data' con la estructura correcta\", function () {\r",
              "\r",
              "        // Validamos que exista el objeto data\r",
              "        pm.expect(jsonData).to.have.property('data');\r",
              "    \r",
              "    \r",
              "        // Validamos que exista el array de items y su contenido\r",
              "        pm.expect(jsonData.data.items).to.be.an('array').that.is.not.empty;\r",
              "        pm.expect(jsonData.data.items[0].producto).to.eql(\"Soporte Premium\");\r",
              "    });\r",
              "}\r",
              "else if(statusCode === 400){\r",
              "\r",
              "    //console.log(jsonData.error.code);\r",
              "    pm.test(\"Code 400 - Body/query inválido o error de ejecución\", () =>{\r",
              "        pm.expect(errorMessage.code).to.eql(\"VALIDATION_ERROR\");\r",
              "    });\r",
              "\r",
              "}\r",
              "else if(statusCode === 401){\r",
              "    pm.test(\"Code 401 - API key inválida, inactiva o ausente\", () =>{\r",
              "        pm.expect(errorMessage.code).to.eql(\"UNAUTHORIZED\");\r",
              "    });\r",
              "}\r",
              "\r",
              "const sqlBody = {\r",
              "  sql: \"SELECT id, activo FROM ordenes WHERE id = $1\",\r",
              "  params: [pm.collectionVariables.get('id')]\r",
              "};\r",
              "\r",
              "pm.sendRequest({\r",
              "        url: pm.variables.get('baseUrl') + '/api/v1/sql/select',\r",
              "        method: 'POST',\r",
              "        header: { 'Content-Type': 'application/json', 'x-api-key': pm.variables.get('x-api-key') },\r",
              "        body: { mode: 'raw', raw: JSON.stringify(sqlBody) }\r",
              "        }, function (err, res) {\r",
              "        if (err) { \r",
              "            console.error('Error en pre-request (usuario):', err); \r",
              "            return; \r",
              "        }\r",
              "        const body = res.json();\r",
              "        if (!body.data || body.data.length === 0) {\r",
              "            console.error('No se encontró producto en qa_training.ordenes');\r",
              "             return;\r",
              "        }\r",
              "        const orden = body.data[0];\r",
              "        pm.test(\"La BD confirma que la orden ha sido creada\", function () {\r",
              "            pm.expect(String(orden.activo)).to.eql(\"true\");\r",
              "         });\r",
              "\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "//var id = pm.collectionVariables.get(\"eliminarId\");\r",
              "const sqlBody = {\r",
              "  sql: \"select * from qa_training.items_orden where id = $1\",\r",
              "  params: [25]\r",
              "};\r",
              "\r",
              "pm.sendRequest({\r",
              "        url: pm.variables.get('baseUrl') + '/api/v1/sql/select',\r",
              "        method: 'POST',\r",
              "        header: { 'Content-Type': 'application/json', 'x-api-key': pm.variables.get('x-api-key') },\r",
              "        body: { mode: 'raw', raw: JSON.stringify(sqlBody) }\r",
              "    }, function (err, res) {\r",
              "        if (err) { console.error('Error en pre-request (usuario):', err); return; }\r",
              "        const body = res.json();\r",
              "        if (!body.data || body.data.length === 0) {\r",
              "    console.error('No se encontró producto en qa_training.ordenes');\r",
              "    return;\r",
              "  }\r",
              "  const orden = body.data[0];\r",
              "  pm.collectionVariables.set('ordenId', orden.id);\r",
              "  pm.collectionVariables.set('producto', orden.producto);\r",
              "  //console.log(body.data[0].producto);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {
          "content-length": true,
          "host": true,
          "user-agent": true,
          "accept": true,
          "accept-encoding": true,
          "connection": true,
          "content-type": true
        }
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{x-api-key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "\r\n{\r\n  \"usuarioId\": \"{{ordenId}}\",\r\n  \"items\": [\r\n    {\r\n      \"producto\": \"{{producto}}\",\r\n      \"cantidad\": 2,\r\n      \"precioUnitario\": 85\r\n    }\r\n  ]\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/ordenes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ordenes"
          ]
        },
        "description": "BDD: Crear una orden exitosamente con un usuario válido."
      },
      "response": []
    },
    {
      "name": "02 - Crear orden - No existe producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const statusCode = pm.response.code;\r",
              "const jsonData = pm.response.json();\r",
              "const errorMessage = jsonData.error;\r",
              "\r",
              " if(statusCode === 400){\r",
              "\r",
              "    //console.log(jsonData.error.code);\r",
              "    pm.test(\"El código de respuesta es 400 Bad Request\", () =>{\r",
              "        // Validamos la estructura del error\r",
              "        pm.response.to.have.status(400);\r",
              "     });\r",
              "\r",
              "\r",
              "    // Validamos que el mensaje contenga información clave de la Foreign Key\r",
              "     pm.test(\"La respuesta captura el error de validación de base de datos\", () => {\r",
              "        pm.expect(jsonData.error.code).to.include(\"VALIDATION_ERROR\");\r",
              "        \r",
              "    });\r",
              "\r",
              "}\r",
              "else if(statusCode === 401){\r",
              "    pm.test(\"Code 401 - API key inválida, inactiva o ausente\", () =>{\r",
              "        pm.expect(errorMessage.code).to.eql(\"UNAUTHORIZED\");\r",
              "    });\r",
              "}\r",
              "\r",
              "const sqlBody = {\r",
              "  sql: \"select * from qa_training.ordenes where id = $1\", // Ajusta la query según tu tabla de órdenes\r",
              "  params: [2000]\r",
              "};\r",
              "\r",
              "// Validaciones de Base de Datos\r",
              "pm.sendRequest({\r",
              "    url: pm.variables.get('baseUrl') + '/api/v1/sql/select',\r",
              "    method: 'POST',\r",
              "    header: { 'Content-Type': 'application/json', 'x-api-key': pm.variables.get('x-api-key') },\r",
              "    body: { mode: 'raw', raw: JSON.stringify(sqlBody) }\r",
              "}, function (err, res) {\r",
              "    if (err) { \r",
              "        console.error('Error al consultar DB en tests:', err); \r",
              "        return; \r",
              "    }\r",
              "    \r",
              "    const body = res.json();\r",
              "    \r",
              "    // Como la creación debió fallar por falta de FK, esperamos que no se haya guardado nada\r",
              "    pm.test(\"La BD confirma que la orden NO fue creada (Control de FK exitoso)\", function () {\r",
              "        pm.expect(body.data.length).to.eql(0);\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 1. Limpiar variables de ejecuciones anteriores\r",
              "pm.collectionVariables.unset('ordenId');\r",
              "pm.collectionVariables.unset('producto');\r",
              "pm.collectionVariables.unset('id');\r",
              "\r",
              "const sqlBody = {\r",
              "  sql: \"select * from qa_training.items_orden where id = $1\",\r",
              "  params: [2000]\r",
              "};\r",
              "\r",
              "pm.sendRequest({\r",
              "        url: pm.variables.get('baseUrl') + '/api/v1/sql/select',\r",
              "        method: 'POST',\r",
              "        header: { 'Content-Type': 'application/json', 'x-api-key': pm.variables.get('x-api-key') },\r",
              "        body: { mode: 'raw', raw: JSON.stringify(sqlBody) }\r",
              "    }, function (err, res) {\r",
              "        if (err) { console.error('Error en pre-request (usuario):', err); return; }\r",
              "        const body = res.json();\r",
              "        if (!body.data || body.data.length === 0) {\r",
              "           console.log('Validación exitosa en pre-request: El producto 2000 no existe en la BD.');\r",
              "    return;\r",
              "  }\r",
              "  const orden = body.data[0];\r",
              "  pm.collectionVariables.set('ordenId', orden.id);\r",
              "  pm.collectionVariables.set('producto', orden.producto);\r",
              "  //console.log(body.data[0].producto);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
