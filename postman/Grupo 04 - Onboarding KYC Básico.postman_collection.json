    {
      "name": "Usuarios con KYC pendiente - Onboarding",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"La consulta responde con status 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Existen usuarios con KYC pendiente\", function () {\r",
              "    pm.expect(response.data).to.be.an(\"array\");\r",
              "    pm.expect(response.data.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "if (response.data.length > 0) {\r",
              "    pm.environment.set(\"usuarioId\", response.data[0].id);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sql\": \"SELECT id, nombre, documento_tipo, documento_numero, kyc_estado FROM usuarios WHERE kyc_estado = $1\",\n  \"params\": [\n    \"pendiente\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/sql/select",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "sql",
            "select"
          ]
        }
      },
