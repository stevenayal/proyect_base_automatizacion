  "item": [
    {
      "name": "Crear usuario - Happy Path",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"El usuario se crea correctamente con status 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"La respuesta contiene el ID del nuevo usuario\", function () {\r",
              "    pm.expect(response.data).to.exist;\r",
              "    pm.expect(response.data.id).to.exist;\r",
              "});\r",
              "\r",
              "if (response.data && response.data.id) {\r",
              "    pm.environment.set(\"usuarioId\", response.data.id);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario QA\",\n  \"email\": \"usuario.qa.290826@example.com\",\n  \"documentoTipo\": \"CI\",\n  \"documentoNumero\": \"7834291\",\n  \"fechaNacimiento\": \"1995-06-12\",\n  \"direccion\": \"Asunción, Paraguay\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "usuarios"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Registro con cédula inválida - Negativo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"El registro es rechazado con status 400\", function () {\r",
              "    pm.response.to.have.status(400);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta contiene un error de validación\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.error).to.exist;\r",
              "    pm.expect(response.error.code).to.eql(\"VALIDATION_ERROR\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
