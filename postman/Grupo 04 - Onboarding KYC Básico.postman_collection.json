    {
      "name": "Obtener usuario por id - Validación",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"El usuario se obtiene correctamente con status 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"El usuario obtenido corresponde al usuario creado\", function () {\r",
              "    pm.expect(response.data.id.toString())\r",
              "        .to.eql(pm.environment.get(\"usuarioId\").toString());\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
