    {
      "name": "Alta válida con validación BD",
      "item": [
        {
          "name": "01 - Crear usuario nuevo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = Date.now();\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"emailNuevo\",\r",
                  "    `usuario${timestamp}@example.com`\r",
                  ");\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"documentoNuevo\",\r",
                  "    `${timestamp}`\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Usuario creado correctamente\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"KYC inicia pendiente\", function () {\r",
                  "    pm.expect(response.data.kyc_estado).to.eql(\"pendiente\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Usuario queda activo\", function () {\r",
                  "    pm.expect(response.data.activo).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"usuarioCreadoId\",\r",
                  "    response.data.id\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nombre\": \"Usuario Automatizado\",\r\n  \"email\": \"{{emailNuevo}}\",\r\n  \"documentoTipo\": \"CI\",\r\n  \"documentoNumero\": \"{{documentoNuevo}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "usuarios"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 - Validar usuario en BD",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"El usuario existe en la BD\", function () {\r",
                  "    pm.expect(response.rowCount).to.eql(1);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"El documento se guardó correctamente\", function () {\r",
                  "    pm.expect(response.data[0].documento_numero)\r",
                  "        .to.eql(pm.collectionVariables.get(\"documentoNuevo\"));\r",
                  "});\r",
                  "\r",
                  "pm.test(\"El KYC quedó pendiente\", function () {\r",
                  "    pm.expect(response.data[0].kyc_estado)\r",
                  "        .to.eql(\"pendiente\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"El usuario quedó activo\", function () {\r",
                  "    pm.expect(response.data[0].activo)\r",
                  "        .to.eql(true);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"sql\": \"SELECT * FROM usuarios WHERE documento_numero = '{{documentoNuevo}}';\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sql/select",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sql",
                "select"
              ]
            }
          },
          "response": []
        }
