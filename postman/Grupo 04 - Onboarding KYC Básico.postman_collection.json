    {
      "name": "Registro con cédula duplicada - Edge Case",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"El registro duplicado es rechazado con status 409\", function () {\r",
              "    pm.response.to.have.status(409);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta informa un conflicto por dato duplicado\", function () {\r",
              "    const response = pm.response.json();\r",
              "\r",
              "    pm.expect(response.error).to.exist;\r",
              "    pm.expect(response.error.code).to.eql(\"CONFLICT\");\r",
              "});"
