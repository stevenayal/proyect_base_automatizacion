  "item": [
    {
      "name": "Validación con Base de Datos",
      "item": [
        {
          "name": "01 - Obtener CI existente desde BD",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "const documento = response.data[0].documento_numero;\r",
                  "\r",
                  "pm.collectionVariables.set(\"documentoExistente\", documento);\r",
                  "\r",
                  "pm.test(\"Se obtuvo un usuario desde la base de datos\", function () {\r",
                  "    pm.expect(response.rowCount).to.be.above(0);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"sql\": \"SELECT * FROM usuarios LIMIT 1;\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sql/select",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sql",
                "select"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 - Validar documento duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Documento duplicado devuelve 409\", function () {\r",
                  "    pm.response.to.have.status(409);\r",
                  "    pm.test(\"El error es CONFLICT\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "    pm.expect(response.error.code).to.eql(\"CONFLICT\");\r",
                  "});\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nombre\": \"Usuario Prueba\",\r\n  \"email\": \"usuario.prueba{{$timestamp}}@example.com\",\r\n  \"documentoTipo\": \"CI\",\r\n  \"documentoNumero\": \"{{documentoExistente}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
