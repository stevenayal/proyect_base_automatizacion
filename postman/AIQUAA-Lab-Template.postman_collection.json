{
  "info": {
    "name": "AIQUAA Lab Team Template",
    "_postman_id": "0d14ceea-1b2d-46aa-a1b8-6f8215f7f7de",
    "description": "Template base para que cada equipo arme su coleccion final.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "candidateId", "value": "team-a" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "Seed Session",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/labs/admin/seed/{{candidateId}}",
        "body": { "mode": "raw", "raw": "{}" }
      }
    },
    {
      "name": "List Products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/labs/test-app/products?sessionId={{sessionId}}"
      }
    },
    {
      "name": "Get Evidence",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/labs/evidence/{{sessionId}}"
      }
    }
  ]
}
