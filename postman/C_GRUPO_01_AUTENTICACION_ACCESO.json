                  "  [\"login\"]",
                  "), function (err, res) {",
                  "  pm.test(\"Post-response Oscar: consulta SQL de login responde 200\", function () {",
                  "    pm.expect(err).to.not.exist;",
                  "    pm.expect(res.code).to.eql(200);",
                  "  });",
                  "  if (err || res.code !== 200) { return; }",
                  "  var despues = parseInt(res.json().data[0].total, 10);",
                  "  pm.test(\"Post-response Oscar: el rechazo no modifico sesiones\", function () {",
                  "    pm.expect(despues).to.eql(parseInt(pm.collectionVariables.get(\"oscarLoginsAntes\"), 10));",
