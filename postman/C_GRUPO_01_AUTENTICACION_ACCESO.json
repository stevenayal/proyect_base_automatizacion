    {
      "name": "01 - Login",
      "item": [
        {
          "name": "01 - Login exitoso (Happy Path)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pre-request: captura la cantidad de sesiones de login previas (precondicion BD).",
                  "var uid = pm.collectionVariables.get(\"usuarioId\") || 1;",
                  "pm.collectionVariables.set(\"sesAntesLogin\", 0);",
                  "pm.sendRequest(utils.bodySqlRest(",
                  "  \"SELECT COUNT(*) AS total FROM sesiones WHERE usuario_id = $1 AND tipo_evento = 'login'\",",
                  "  [uid]",
                  "), function (err, res) {",
                  "  if (!err) {",
                  "    pm.collectionVariables.set(\"sesAntesLogin\", parseInt(res.json().data[0].total, 10));",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 - Login exitoso\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Tiempo de respuesta < 3000 ms\", function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Esquema JSON: data con id, email y activo\", function () {",
                  "  pm.expect(json).to.have.property(\"data\");",
                  "  pm.expect(json.data).to.have.property(\"id\");",
                  "  pm.expect(json.data).to.have.property(\"email\");",
                  "  pm.expect(json.data).to.have.property(\"activo\");",
                  "  pm.expect(json.data.activo).to.eql(true);",
                  "});",
                  "// Captura del token/identificador de sesion devuelto por la API.",
                  "pm.collectionVariables.set(\"authToken\", json.data.id);",
                  "pm.collectionVariables.set(\"usuarioId\", json.data.id);",
                  "console.log(\"authToken (usuarioId) capturado:\", json.data.id);",
                  "// Validacion en BD: se registro la sesion de login.",
                  "pm.sendRequest(utils.bodySqlRest(",
                  "  \"SELECT COUNT(*) AS total FROM sesiones WHERE usuario_id = $1 AND tipo_evento = 'login'\",",
                  "  [json.data.id]",
                  "), function (err, res) {",
                  "  if (err) { console.error(err); return; }",
                  "  var despues = parseInt(res.json().data[0].total, 10);",
                  "  pm.test(\"BD: se inserto una sesion de login para el usuario\", function () {",
                  "    pm.expect(despues).to.be.above(pm.collectionVariables.get(\"sesAntesLogin\"));",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
