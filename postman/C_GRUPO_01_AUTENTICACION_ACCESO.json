              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "05b - Login rechazado con email obligatorio vacio",
          "description": "Aporte de Oscar Benitez. Mapea el escenario BDD de campos obligatorios vacios y comprueba por SQL que el rechazo no crea eventos de login.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"oscarLoginsAntes\", 0);",
