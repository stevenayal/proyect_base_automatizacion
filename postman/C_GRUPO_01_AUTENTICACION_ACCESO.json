    "name": "Grupo 01 - Autenticacion y Acceso (Semana 03)",
    "description": "Coleccion del Grupo 01 (Autenticacion y Acceso) - Semana 03. Aplica el patron SQL REST dinamico: prepara/valida datos en la BD (qa_training) antes y despues de cada operacion de autenticacion y acceso. Assertions reales sobre status 200/201/400/401/404, esquema JSON, tiempo de respuesta y tokens/identificadores devueltos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Helper reutilizable para consultar la BD via /api/v1/sql/select (solo lectura).",
          "if (typeof utils === \"undefined\") {",
          "  utils = {",
          "    bodySqlRest: function (sql, params) {",
          "      return {",
          "        url: pm.variables.get(\"baseUrl\") + \"/api/v1/sql/select\",",
          "        method: \"POST\",",
          "        header: {",
          "          \"Content-Type\": \"application/json\",",
          "          \"x-api-key\": pm.variables.get(\"apiKey\")",
          "        },",
          "        body: {",
          "          mode: \"raw\",",
          "          raw: JSON.stringify({ sql: sql, params: params || [] })",
          "        }",
          "      };",
          "    }",
          "  };",
          "}",
          "// Reset de variables por defecto antes de cada request.",
          "pm.collectionVariables.set(\"usuarioId\", 1);",
          "pm.collectionVariables.set(\"email\", \"ana.torres@example.com\");"
        ]
      }
    }
  ],
