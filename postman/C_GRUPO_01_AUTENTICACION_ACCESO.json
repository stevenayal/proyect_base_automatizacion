    {
      "name": "04 - Sesiones (POST /api/v1/sesiones) - E2E con SQL",
      "item": [
        {
          "name": "04a - Crear sesion (Happy Path, E2E SQL)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var uid = pm.collectionVariables.get(\"usuarioId\") || 1;",
                  "pm.collectionVariables.set(\"sesAntesE2E\", 0);",
                  "pm.sendRequest(utils.bodySqlRest(",
                  "  \"SELECT u.id, COUNT(s.id) AS total FROM usuarios u LEFT JOIN sesiones s ON s.usuario_id = u.id WHERE u.id = $1 GROUP BY u.id\",",
                  "  [uid]",
                  "), function (err, res) {",
                  "  pm.test(\"Precondicion BD: el usuario destino existe\", function () {",
                  "    pm.expect(res.json().data.length).to.be.above(0);",
                  "  });",
                  "  if (!err) {",
                  "    pm.collectionVariables.set(\"sesAntesE2E\", parseInt(res.json().data[0].total, 10));",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 201 - Sesion creada\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Tiempo de respuesta < 3000 ms\", function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Esquema JSON: data con id, usuario_id, tipo_evento, exitoso\", function () {",
                  "  pm.expect(json.data).to.have.property(\"id\");",
                  "  pm.expect(json.data).to.have.property(\"usuario_id\");",
                  "  pm.expect(json.data).to.have.property(\"tipo_evento\");",
                  "  pm.expect(json.data).to.have.property(\"exitoso\");",
                  "  pm.expect(json.data.exitoso).to.eql(true);",
                  "});",
                  "// Captura del token de sesion devuelto.",
                  "pm.collectionVariables.set(\"sesionId\", json.data.id);",
                  "pm.sendRequest(utils.bodySqlRest(",
                  "  \"SELECT COUNT(*) AS total FROM sesiones WHERE usuario_id = $1\",",
                  "  [json.data.usuario_id]",
                  "), function (err, res) {",
                  "  if (err) { console.error(err); return; }",
                  "  var despues = parseInt(res.json().data[0].total, 10);",
                  "  pm.test(\"BD: se inserto la sesion (COUNT aumento)\", function () {",
                  "    pm.expect(despues).to.be.above(pm.collectionVariables.get(\"sesAntesE2E\"));",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sesiones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sesiones"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": {{usuarioId}},\n  \"tipoEvento\": \"login\",\n  \"exitoso\": \"true\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "04b - Crear sesion con usuario inexistente (400, BD sin cambios)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"sesAntesFK\", 0);",
                  "pm.sendRequest(utils.bodySqlRest(",
                  "  \"SELECT COUNT(*) AS total FROM sesiones WHERE usuario_id = $1\",",
                  "  [99999]",
                  "), function (err, res) {",
                  "  if (!err) {",
                  "    pm.collectionVariables.set(\"sesAntesFK\", parseInt(res.json().data[0].total, 10));",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 400 - FK invalida rechazada\", function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Esquema JSON: error con codigo VALIDATION_ERROR\", function () {",
                  "  pm.expect(json.error.code).to.eql(\"VALIDATION_ERROR\");",
                  "});",
                  "pm.sendRequest(utils.bodySqlRest(",
                  "  \"SELECT COUNT(*) AS total FROM sesiones WHERE usuario_id = $1\",",
                  "  [99999]",
                  "), function (err, res) {",
                  "  if (err) { console.error(err); return; }",
                  "  var despues = parseInt(res.json().data[0].total, 10);",
                  "  pm.test(\"BD: la base NO cambio (COUNT sin modificacion)\", function () {",
                  "    pm.expect(despues).to.eql(pm.collectionVariables.get(\"sesAntesFK\"));",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
