{
  "info": {
    "name": "Grupo 03 - Pagos de Servicios (Regression)",
    "description": "Pruebas de regresion BDD para RF-G3-01..06 (facturas/pagos). Ejecutar con Newman contra la API en vivo + DB qa_training. Incluye el patron SQL REST dinamico (pre/post-request contra /api/v1/sql/select) exigido por docs/TAREA-SQL-REST-DINAMICO.md sobre POST /api/v1/facturas/{id}/pagar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request Script DE LA COLECCION — declarado una sola vez.",
          "// utils.bodySqlRest arma el objeto que se le pasa a pm.sendRequest(...)",
          "// para correr un SELECT de solo lectura contra qa_training via",
          "// /api/v1/sql/select. Usado por la carpeta 'E2E - SQL (validacion BD)'.",
          "if (typeof utils === 'undefined') {",
          "  utils = {",
          "    bodySqlRest: function (sql, params) {",
          "      return {",
          "        url: pm.collectionVariables.get('baseUrl') + '/api/v1/sql/select',",
          "        method: 'POST',",
          "        header: {",
          "          'Content-Type': 'application/json',",
          "          'x-api-key': pm.collectionVariables.get('apiKey')",
          "        },",
          "        body: {",
          "          mode: 'raw',",
          "          raw: JSON.stringify({ sql: sql, params: params || [] })",
          "        }",
          "      };",
          "    }",
          "  };",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "apiKey", "value": "REEMPLAZAR_CON_API_KEY_VALIDA" },
    { "key": "facturaId", "value": "" },
    { "key": "facturaId2", "value": "" },
    { "key": "facturaNumero", "value": "" },
    { "key": "facturaIdSql", "value": "" },
    { "key": "pagosCountAntes", "value": "" }
  ],
  "item": [
    {
      "name": "G3-01 Listar todas las facturas (sin filtro)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-api-key", "value": "{{apiKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/facturas",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "facturas"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('data es arreglo', () => pm.expect(Array.isArray(j.data)).to.be.true);"
            ]
          }
        }
      ]
    },
