    {
      "name": "E2E - SQL (validacion BD)",
      "description": "Patron obligatorio de docs/TAREA-SQL-REST-DINAMICO.md sobre POST /api/v1/facturas/{id}/pagar (endpoint de escritura del modulo propio). El caso feliz replica el ejemplo de referencia (postman/aiquaa Sandbox API.json > E2E - Flujos con validacion SQL); el segundo request es el caso propio del grupo 3: pagar una factura ya 'pagada' -> 404 y confirmar via SQL que NO se duplico el pago.",
      "item": [
        {
          "name": "E2E Crear factura para el flujo SQL (setup)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/facturas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "facturas"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"usuarioId\":1,\"proveedor\":\"Tigo\",\"numeroFactura\":\"TIGO-SQL-{{$timestamp}}\",\"monto\":58000,\"fechaVencimiento\":\"2026-09-14\"}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "No se usa un id fijo del seed a proposito: se crea una factura real y fresca en 'pendiente' para que el caso feliz y el caso propio de abajo sean deterministas y no choquen con corridas de otros grupos sobre los mismos ids de seed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('facturaIdSql', j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "E2E Pagar factura pendiente (feliz) - valida BD pre/post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/facturas/{{facturaIdSql}}/pagar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "facturas", "{{facturaIdSql}}", "pagar"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"metodoPago\":\"tarjeta\"}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "UPDATE via endpoint de accion. Pre-request: confirma en la BD que la factura todavia esta 'pendiente'. Post-request: relee facturas+pagos y valida que el estado y el pago quedaron persistidos (misma logica que el ejemplo de referencia, parametrizada a nuestra propia factura)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pre-request: confirma que la factura todavia no esta pagada.",
                  "// Si /pagar ya la hubiera marcado 'pagada', un segundo pago",
                  "// respondera 404 (lo que se prueba en el request siguiente).",
                  "const facturaId = Number(pm.collectionVariables.get('facturaIdSql'));",
                  "const request = utils.bodySqlRest('SELECT id, estado FROM facturas WHERE id = $1', [facturaId]);",
                  "pm.sendRequest(request, (err, res) => {",
                  "  if (err) { console.error('Pre-request SQL check fallo:', err); return; }",
                  "  const row = res.json().data[0];",
                  "  console.log('Estado de la factura antes de pagar:', row && row.estado);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('La respuesta trae la factura pagada y el pago generado', () => {",
                  "  pm.expect(body.data.factura.estado).to.eql('pagada');",
                  "  pm.expect(body.data.pago).to.have.property('id');",
                  "});",
                  "",
                  "const facturaId = Number(pm.collectionVariables.get('facturaIdSql'));",
                  "",
                  "// Post-request: confirma en la BD que la factura quedo 'pagada' Y que",
                  "// se genero la fila en 'pagos' (operacion transaccional).",
                  "const requestJoin = utils.bodySqlRest(",
                  "  'SELECT f.estado AS factura_estado, p.estado AS pago_estado FROM facturas f JOIN pagos p ON p.factura_id = f.id WHERE f.id = $1 ORDER BY p.id DESC LIMIT 1',",
                  "  [facturaId]",
                  ");",
                  "pm.sendRequest(requestJoin, (err, res) => {",
                  "  pm.test('La BD confirma factura pagada + pago registrado', () => {",
                  "    if (err) throw err;",
                  "    const row = res.json().data[0];",
                  "    pm.expect(row, 'no se encontro el pago en la BD').to.not.be.undefined;",
                  "    pm.expect(row.factura_estado).to.eql('pagada');",
                  "    pm.expect(row.pago_estado).to.eql('procesado');",
                  "  });",
                  "});",
                  "",
                  "// Guarda el COUNT(*) de pagos de esta factura para que el caso propio",
                  "// (siguiente request) pueda confirmar que NO crece tras el 404.",
                  "const requestCount = utils.bodySqlRest('SELECT COUNT(*)::int AS total FROM pagos WHERE factura_id = $1', [facturaId]);",
                  "pm.sendRequest(requestCount, (err, res) => {",
                  "  if (err) { console.error('Count post-pago fallo:', err); return; }",
                  "  pm.collectionVariables.set('pagosCountAntes', res.json().data[0].total);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E2E (caso propio G3) Pagar factura ya pagada -> 404 sin duplicar el pago",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/facturas/{{facturaIdSql}}/pagar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "facturas", "{{facturaIdSql}}", "pagar"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"metodoPago\":\"cuenta\"}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Caso propio pedido en docs/TAREA-SQL-REST-DINAMICO.md para el grupo 3: reintentar el pago de una factura que el request anterior ya dejo 'pagada'. Se espera 404 (evita el doble pago) y que el COUNT(*) de pagos de la factura NO haya cambiado respecto al capturado despues del pago feliz."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pre-request: reconfirma en la BD que la factura ya esta 'pagada'",
                  "// antes de reintentar el pago (precondicion del caso negativo).",
                  "const facturaId = Number(pm.collectionVariables.get('facturaIdSql'));",
                  "const request = utils.bodySqlRest('SELECT id, estado FROM facturas WHERE id = $1', [facturaId]);",
                  "pm.sendRequest(request, (err, res) => {",
                  "  if (err) { console.error('Pre-request SQL check fallo:', err); return; }",
                  "  const row = res.json().data[0];",
                  "  console.log('Estado de la factura antes del segundo intento de pago:', row && row.estado);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404 (evita doble pago)', () => pm.response.to.have.status(404));",
                  "",
                  "const facturaId = Number(pm.collectionVariables.get('facturaIdSql'));",
                  "const countAntes = Number(pm.collectionVariables.get('pagosCountAntes'));",
                  "",
                  "// Post-request: relee la BD y confirma que NO se inserto un segundo",
                  "// pago para esta factura (COUNT(*) sin cambios) y que el estado",
                  "// sigue siendo 'pagada' (no quedo en un estado intermedio raro).",
                  "const requestCheck = utils.bodySqlRest(",
                  "  'SELECT f.estado AS factura_estado, (SELECT COUNT(*)::int FROM pagos p WHERE p.factura_id = f.id) AS pagos_count FROM facturas f WHERE f.id = $1',",
                  "  [facturaId]",
                  ");",
                  "pm.sendRequest(requestCheck, (err, res) => {",
                  "  pm.test('La BD confirma que no se duplico el pago', () => {",
                  "    if (err) throw err;",
                  "    const row = res.json().data[0];",
                  "    pm.expect(row.factura_estado).to.eql('pagada');",
                  "    pm.expect(row.pagos_count).to.eql(countAntes);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
