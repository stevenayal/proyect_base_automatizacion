  "item": [
    {
      "name": "Eliminar producto de carrito - Andrea",
      "item": [
        {
          "name": "1-Crear Orden",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status es 201', function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "pm.test('Guardo el id de la orden a eliminar', function () {\r",
                  "    var d = pm.response.json().data;\r",
                  "    pm.collectionVariables.set('eliminarId', String(d.id));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"usuarioId\": 3,\r\n  \"items\": [\r\n    { \"producto\": \"Cable HDMI\", \"cantidad\": 1, \"precioUnitario\": 50000 }\r\n  ]\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ordenes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ordenes"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2-Dar de Baja",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status es 204', function () {\r",
                  "    pm.response.to.have.status(204);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ordenes/{{eliminarId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ordenes",
                "{{eliminarId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3-Verificar Baja",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status es 404 (orden dada de baja)', function () {\r",
                  "    pm.response.to.have.status(404);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ordenes/{{eliminarId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ordenes",
                "{{eliminarId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
