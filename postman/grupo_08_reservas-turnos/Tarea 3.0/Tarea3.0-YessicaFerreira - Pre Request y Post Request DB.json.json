  "item": [
    {
      "name": "CP001 - Crear y confirmar reserva",
      "item": [
        {
          "name": "01 - CP001 - Crear reserva (pre + post DB)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tarea 3.0 - Pre Request: obtener datos dinámicos desde la BD mediante la API SQL.",
                  "const baseUrl = pm.environment.get('baseUrl');",
                  "const apiKey = pm.environment.get('apiKey');",
                  "",
                  "pm.test('PreRequest: baseUrl configurado', function () {",
                  "    pm.expect(baseUrl, 'baseUrl').to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (apiKey) {",
                  "    pm.sendRequest({",
                  "        url: baseUrl + '/api/v1/sql/select',",
                  "        method: 'POST',",
                  "        header: {",
                  "            'Content-Type': 'application/json',",
                  "            'x-api-key': apiKey",
                  "        },",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify({",
                  "                sql: 'SELECT id, usuario_id, servicio, fecha_hora, estado FROM reservas ORDER BY id DESC LIMIT 1',",
                  "                params: []",
                  "            })",
                  "        }",
                  "    }, function (err, res) {",
                  "        if (!err && res && res.code >= 200 && res.code < 300) {",
                  "            try {",
                  "                const body = res.json();",
                  "                const rows = Array.isArray(body.data) ? body.data : [];",
                  "                if (rows.length > 0 && rows[0].id !== undefined) {",
                  "                    pm.environment.set('lastDbReservationId', String(rows[0].id));",
                  "                    pm.environment.set('lastDbEstado', String(rows[0].estado || ''));",
                  "                }",
                  "            } catch (e) {",
                  "                console.warn('No fue posible interpretar el SELECT previo:', e.message);",
                  "            }",
                  "        }",
                  "    });",
                  "} else {",
                  "    console.warn('apiKey no está configurada; el request principal puede fallar por autenticación.');",
                  "}",
                  "// Genera datos de prueba únicos para evitar colisiones entre ejecuciones.",
                  "const now = new Date();",
                  "const uniqueSuffix = now.getTime();",
                  "pm.environment.set('testService', 'Corte de Cabello');",
                  "pm.environment.set('testNotes', 'Yessica Tarea3 ' + uniqueSuffix);",
                  "",
                  "// Fecha ISO futura y estable para la prueba.",
                  "// Se usa un horario 30 días adelante para reducir la posibilidad de colisión.",
                  "const future = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);",
                  "future.setHours(10, 0, 0, 0);",
                  "pm.environment.set('testDateTime', future.toISOString());",
                  "pm.environment.set('testUserId', pm.environment.get('usuarioId') || '19');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"{{testUserId}}\",\n  \"servicio\": \"{{testService}}\",\n  \"fechaHora\": \"{{testDateTime}}\",\n  \"notas\": \"{{testNotes}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reservas"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 - CP001 - Consultar reserva creada y validar BD",
