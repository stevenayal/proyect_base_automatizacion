    {
      "name": "CP002 - Horario ocupado",
      "item": [
        {
          "name": "01 - CP002 - Intentar reservar horario ocupado",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pre Request: reutiliza exactamente el horario creado en CP001 y valida por SQL que está ocupado.\nconst baseUrl=pm.environment.get('baseUrl'), apiKey=pm.environment.get('apiKey'), dt=pm.environment.get('testDateTime');\npm.expect(dt, 'testDateTime').to.be.a('string').and.not.empty;\npm.sendRequest({url:baseUrl+'/api/v1/sql/select',method:'POST',header:{'Content-Type':'application/json','x-api-key':apiKey},body:{mode:'raw',raw:JSON.stringify({sql:'SELECT id, estado FROM reservas WHERE fecha_hora = $1 LIMIT 1',params:[dt]})}},(err,res)=>{\n    if(!err && res.code>=200 && res.code<300 && res.json().data.length){ pm.environment.set('occupiedReservationId',String(res.json().data[0].id)); }\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"{{testUserId}}\",\n  \"servicio\": \"{{testService}}\",\n  \"fechaHora\": \"{{testDateTime}}\",\n  \"notas\": \"Yessica CP002 horario ocupado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reservas"
              ]
            }
          },
          "response": []
        },
        {
