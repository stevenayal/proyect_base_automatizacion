{
  "info": {
    "_postman_id": "f271813b-ba41-4b6b-91e7-2f9d28a1f870",
    "name": "Tarea3.0-YessicaFerreira - Pre Request y Post Request DB",
    "description": "Automatización de los casos de Tarea2-YessicaFerreira para Tarea 3.0. Incluye Pre Request y Post Request con validación mediante /api/v1/sql/select y /api/v1/sql/update.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "47241162",
    "_collection_link": "https://go.postman.co/collection/47241162-f271813b-ba41-4b6b-91e7-2f9d28a1f870?source=collection_link"
