                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservas/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reservas",
                "{{reservationId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "03 - CP001 - Confirmar reserva mediante endpoint",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.expect(pm.environment.get('reservationId'), 'reservationId').to.be.a('string').and.not.empty;"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "PATCH",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservas/{{reservationId}}/confirmar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reservas",
                "{{reservationId}}",
                "confirmar"
              ]
            }
          },
          "response": []
        }
      ]
