      "item": [
        {
          "name": "CP001 - Paciente - Crear Reserva",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 o 200', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('Tiempo de respuesta menor a 3000 ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "",
                  "pm.test('Content-Type es JSON cuando hay body', function () {",
                  "    var contentType = pm.response.headers.get('Content-Type') || '';",
                  "    pm.expect(contentType.toLowerCase()).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('La respuesta tiene estructura de reserva', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "    pm.expect(jsonData.data).to.have.property('id');",
                  "    pm.expect(jsonData.data).to.have.property('usuario_id');",
                  "    pm.expect(jsonData.data).to.have.property('servicio');",
                  "    pm.expect(jsonData.data).to.have.property('fecha_hora');",
                  "    pm.expect(jsonData.data).to.have.property('estado');",
                  "});",
                  "",
                  "pm.test('La reserva creada queda en estado válido', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.estado).to.be.oneOf(['pendiente', 'confirmada', 'cancelada']);",
                  "});",
                  "",
                  "pm.test('Los campos clave de la reserva creada son consistentes', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var requestData = JSON.parse(pm.request.body.raw || '{}');",
                  "    if (requestData.usuarioId !== undefined) {",
                  "        pm.expect(jsonData.data.usuario_id).to.eql(requestData.usuarioId);",
                  "    }",
                  "    if (requestData.servicio !== undefined) {",
                  "        pm.expect(jsonData.data.servicio).to.eql(requestData.servicio);",
                  "    }",
                  "    if (requestData.notas !== undefined) {",
                  "        pm.expect(jsonData.data.notas).to.eql(requestData.notas);",
                  "    }",
                  "});",
                  "",
                  "pm.test('id de reserva es numérico y fecha_hora existe', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.id).to.be.a('number');",
                  "    pm.expect(jsonData.data.fecha_hora).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
