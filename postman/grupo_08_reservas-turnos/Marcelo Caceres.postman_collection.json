  "item": [
    {
      "name": "1 Listar reservas (Grupo 8)​",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const reserva = response.data.find(r => r.estado === \"pendiente\");",
              "if (reserva) {",
              "    pm.environment.set(\"reserva_id\", reserva.id);",
              "    console.log(\"reserva_id guardado:\", reserva.id);",
              "} else {",
              "    console.warn(\"No se encontró ninguna reserva con estado pendiente\");",
              "}",
              "",
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "",
              "pm.test(\"El sistema debe responder con un error de validación\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 401, 409, 422]);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "YOUR_SECRET_TOKEN",
            "disabled": true
          },
          {
            "key": "x-api-key",
            "value": "{{api_key}}",
            "type": "text"
          }
        ],
        "url": {
