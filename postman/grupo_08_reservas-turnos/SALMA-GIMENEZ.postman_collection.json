		{
			"name": "CP002 - Reservas - Reserva exitosa de un turno",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"La reserva se crea correctamente\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"La respuesta contiene los datos de la reserva\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"\r",
							"    pm.expect(jsonData).to.have.property(\"data\");\r",
							"    pm.expect(jsonData.data).to.have.property(\"id\");\r",
							"    pm.expect(jsonData.data).to.have.property(\"usuario_id\");\r",
							"    pm.expect(jsonData.data).to.have.property(\"servicio\");\r",
							"    pm.expect(jsonData.data).to.have.property(\"fecha_hora\");\r",
							"    pm.expect(jsonData.data).to.have.property(\"estado\");\r",
							"});\r",
							"\r",
							"pm.test(\"Los datos de la reserva son correctos\", function () {\r",
							"    const reserva = pm.response.json().data;\r",
							"\r",
							"    pm.expect(reserva.usuario_id).to.eql(\"1\");\r",
							"    pm.expect(reserva.servicio).to.eql(\"Corte de Cabello\");\r",
							"    pm.expect(reserva.estado).to.eql(\"pendiente\");\r",
							"});\r",
							"\r",
							"pm.test(\"El tiempo de respuesta es menor a 3000ms\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
							"});"
						],
