	"item": [
		{
			"name": "CP001 - Reservas - Consulta exitosa de una reserva existente",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"La consulta de la reserva es exitosa\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"La reserva consultada corresponde al ID 26\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"\r",
							"    pm.expect(jsonData.data.id).to.eql(\"26\");\r",
							"});\r",
							"\r",
							"pm.test(\"La reserva contiene los datos esperados\", function () {\r",
							"    const reserva = pm.response.json().data;\r",
							"\r",
							"    pm.expect(reserva).to.have.property(\"id\");\r",
							"    pm.expect(reserva).to.have.property(\"usuario_id\");\r",
							"    pm.expect(reserva).to.have.property(\"servicio\");\r",
							"    pm.expect(reserva).to.have.property(\"fecha_hora\");\r",
							"    pm.expect(reserva).to.have.property(\"estado\");\r",
							"    pm.expect(reserva).to.have.property(\"activo\");\r",
							"});\r",
							"\r",
							"pm.test(\"El tiempo de respuesta es menor a 3000ms\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
