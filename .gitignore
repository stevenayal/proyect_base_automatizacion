# Dependencias
node_modules/

# Variables de entorno (contiene credenciales reales)
.env

# Resultados de tests Playwright
test-results/
playwright-report/
blob-report/

# Resultados de tests Cucumber/BDD
results/

# Resultados de Newman
newman/

# Logs
*.log
npm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp

# Indice local de CodeGraph (base SQLite regenerable con `codegraph init -i`)
.codegraph/

# Memoria local de Engram (chunks de sincronizacion por proyecto)
.engram/

# Configuracion personal de Claude Code (no se comparte entre integrantes)
.claude/settings.local.json

# Reportes de Newman: el JSON incluye el valor de la API key
newman-*.json
reporte-newman*.json
