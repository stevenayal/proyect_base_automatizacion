{
  "name": "proyect-base-automatizacion",
  "private": true,
  "version": "0.1.0",
  "description": "Base academica para automatizar AIQUAA como sitio bajo prueba.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:api": "newman run postman/AIQUAA-Lab-Template.postman_collection.json -e postman/local.postman_environment.json",
    "test:bdd": "cucumber-js \"features/**/*.feature\" \"grupos/**/*.feature\"",
    "test:bdd:demo": "cucumber-js --profile demo",
    "test:bdd:sandbox": "node tests/bdd/sandbox-pom/scripts/run-sandbox.cjs",
    "YF:classify:bdd": "node tests/bdd/YF-agentes/YF-classify-bdd.mjs",
    "smoke": "playwright test tests/e2e/smoke.spec.ts",
    "verify": "npm run test:api && npm run test:e2e",
    "test:bdd:ordenes-andrea": "cucumber-js --config tests/bdd/grupo07-ordenes-andrea/cucumber.js --profile default",
    "test:bdd:ordenes-andrea:dryrun": "cucumber-js --config tests/bdd/grupo07-ordenes-andrea/cucumber.js --profile dryrun",
    "test:bdd:ordenes-andrea:classify": "node tests/bdd/grupo07-ordenes-andrea/scripts/classify-failures.mjs --input results/grupo07-andrea/cucumber-grupo07-andrea.json --out results/grupo07-andrea/CLASIF_GRUPO07-ANDREA.json",
    "test:bdd:ordenes-andrea:smoke": "node tests/bdd/grupo07-ordenes-andrea/scripts/smoke-locators.mjs",
    "test:semana06": "cucumber-js --config cucumber.semana06.js",
    "cucumber:semana06": "cucumber-js --config cucumber.semana06.js",
    "report:semana06": "python3 reporters/semana06-report.py --results grupos/grupo-01-autenticacion-acceso/reports/semana-06/cucumber-report.json --output grupos/grupo-01-autenticacion-acceso/reports/semana-06/INFORME_SEMANA06.pdf",
    "test:semana06:dry": "cucumber-js --config cucumber.semana06.js --profile dry"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.1",
    "@playwright/test": "^1.54.2",
    "dotenv": "^17.2.3",
    "newman": "^6.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
